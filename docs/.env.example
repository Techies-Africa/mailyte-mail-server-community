
# Documentation Service Configuration

# Domain configuration
DOCS_DOMAIN=docs.mailyte.com
SITE_NAME=Mailyte Email Server Handbook
SITE_DESCRIPTION=The complete developer handbook for the Mailyte Email Server
SITE_URL=https://docs.mailyte.com

# Port (for local access)
DOCS_PORT=8000

# SSL/ACME Configuration
ACME_EMAIL=admin@mailyte.com
ACME_STAGING=false
CERT_RENEWAL_DAYS=30
CERT_CHECK_INTERVAL=21600

# Webhook notifications
WEBHOOK_URLS=https://api.mailyte.com/webhooks/ssl
WEBHOOK_SECRET=your-webhook-secret-key

# Optional: Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
