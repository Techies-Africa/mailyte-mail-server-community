    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- distribution_group_members -> distribution_groups, email_accounts
ALTER TABLE distribution_group_members ADD CONSTRAINT fk_group_member_group
    FOREIGN KEY (group_id) REFERENCES distribution_groups(id) ON DELETE CASCADE;
ALTER TABLE distribution_group_members ADD CONSTRAINT fk_group_member_account
    FOREIGN KEY (email_account_id) REFERENCES email_accounts(id) ON DELETE SET NULL;

-- transport_rules -> organizations
ALTER TABLE transport_rules ADD CONSTRAINT fk_transport_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- quarantine -> organizations, transport_rules
ALTER TABLE quarantine ADD CONSTRAINT fk_quarantine_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;
ALTER TABLE quarantine ADD CONSTRAINT fk_quarantine_rule
    FOREIGN KEY (rule_id) REFERENCES transport_rules(id) ON DELETE SET NULL;

-- migration_jobs -> organizations
ALTER TABLE migration_jobs ADD CONSTRAINT fk_migration_org
    FOREIGN KEY (org_id) REFERENCES organizations(id) ON DELETE SET NULL;

-- dlp_policies -> organizations
ALTER TABLE dlp_policies ADD CONSTRAINT fk_dlp_policies_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- dlp_violations -> organizations, dlp_policies
ALTER TABLE dlp_violations ADD CONSTRAINT fk_dlp_violations_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;
ALTER TABLE dlp_violations ADD CONSTRAINT fk_dlp_violations_policy
    FOREIGN KEY (policy_id) REFERENCES dlp_policies(id) ON DELETE CASCADE;

-- geo_policies -> organizations
ALTER TABLE geo_policies ADD CONSTRAINT fk_geo_policies_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- oauth_clients -> organizations
ALTER TABLE oauth_clients ADD CONSTRAINT fk_oauth_client_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- email_templates -> organizations
ALTER TABLE email_templates ADD CONSTRAINT fk_template_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- email_template_versions -> email_templates
ALTER TABLE email_template_versions ADD CONSTRAINT fk_tmpl_ver_template
    FOREIGN KEY (template_id) REFERENCES email_templates(id) ON DELETE CASCADE;

-- email_archive -> organizations
ALTER TABLE email_archive ADD CONSTRAINT fk_archive_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- retention_policies -> organizations
ALTER TABLE retention_policies ADD CONSTRAINT fk_retention_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- legal_holds -> organizations
ALTER TABLE legal_holds ADD CONSTRAINT fk_legal_hold_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- migration_errors -> migration_jobs (FK on job_id VARCHAR column, not the PK)
-- This FK references migration_jobs.job_id (VARCHAR), not the new ULID PK,
-- so it remains unchanged.


-- =============================================================================
-- STEP 6: Recreate the audit_log compatibility view
-- =============================================================================
-- The view was created in migration 008 and references audit_logs columns.
-- Since we changed the id type, recreate it.

CREATE OR REPLACE VIEW audit_log AS
    SELECT
        id,
        event_type  AS action,
        user_email,
        performed_by,
        client_ip   AS ip_address,
        details,
        created_at
    FROM audit_logs;


-- =============================================================================
-- STEP 7: Clean up helper function
-- =============================================================================

DROP FUNCTION IF EXISTS generate_ulid_backfill;


-- =============================================================================
-- STEP 8: Update Alembic version
-- =============================================================================

UPDATE alembic_version SET version_num = '009_ulid_primary_keys'
WHERE version_num = '008_missing_tables';

INSERT INTO alembic_version (version_num)
SELECT '009_ulid_primary_keys'
WHERE NOT EXISTS (
    SELECT 1 FROM alembic_version WHERE version_num = '009_ulid_primary_keys'
);
