-- dlp_policies -> organizations (unnamed FK from 006, use generated name)
-- These may have auto-generated constraint names; drop by looking them up
SET @db_name = DATABASE();

-- dlp_policies FK
SET @fk_name = (
    SELECT CONSTRAINT_NAME FROM information_schema.TABLE_CONSTRAINTS
    WHERE TABLE_SCHEMA = @db_name AND TABLE_NAME = 'dlp_policies'
    AND CONSTRAINT_TYPE = 'FOREIGN KEY' LIMIT 1
);
SET @sql = IF(@fk_name IS NOT NULL, CONCAT('ALTER TABLE dlp_policies DROP FOREIGN KEY `', @fk_name, '`'), 'SELECT 1');
PREPARE stmt FROM @sql; EXECUTE stmt; DEALLOCATE PREPARE stmt;

-- dlp_violations FKs (org + policy)
SET @fk_name = (
    SELECT CONSTRAINT_NAME FROM information_schema.TABLE_CONSTRAINTS
    WHERE TABLE_SCHEMA = @db_name AND TABLE_NAME = 'dlp_violations'
    AND CONSTRAINT_TYPE = 'FOREIGN KEY' LIMIT 1
);
SET @sql = IF(@fk_name IS NOT NULL, CONCAT('ALTER TABLE dlp_violations DROP FOREIGN KEY `', @fk_name, '`'), 'SELECT 1');
PREPARE stmt FROM @sql; EXECUTE stmt; DEALLOCATE PREPARE stmt;

SET @fk_name = (
