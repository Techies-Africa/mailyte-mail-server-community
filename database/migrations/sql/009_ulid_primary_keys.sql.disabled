-- =============================================================================
-- STEP 5: Re-add ALL foreign key constraints
-- =============================================================================

-- organizations self-reference
ALTER TABLE organizations ADD CONSTRAINT fk_org_parent
    FOREIGN KEY (parent_organization_id) REFERENCES organizations(id) ON DELETE SET NULL;

-- domains -> organizations
ALTER TABLE domains ADD CONSTRAINT fk_domains_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- email_accounts -> domains, organizations
ALTER TABLE email_accounts ADD CONSTRAINT fk_email_accounts_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);
ALTER TABLE email_accounts ADD CONSTRAINT fk_email_accounts_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- aliases -> domains, organizations
ALTER TABLE aliases ADD CONSTRAINT fk_aliases_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);
ALTER TABLE aliases ADD CONSTRAINT fk_aliases_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- user_sessions -> email_accounts
ALTER TABLE user_sessions ADD CONSTRAINT fk_sessions_email_account
    FOREIGN KEY (email_account_id) REFERENCES email_accounts(id);

-- mail_queue -> organizations
ALTER TABLE mail_queue ADD CONSTRAINT fk_mail_queue_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- mail_logs -> organizations
ALTER TABLE mail_logs ADD CONSTRAINT fk_mail_logs_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- email_tracking -> organizations, domains
ALTER TABLE email_tracking ADD CONSTRAINT fk_email_tracking_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);
ALTER TABLE email_tracking ADD CONSTRAINT fk_email_tracking_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);

-- tracking_statistics -> organizations, domains
ALTER TABLE tracking_statistics ADD CONSTRAINT fk_tracking_stats_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);
ALTER TABLE tracking_statistics ADD CONSTRAINT fk_tracking_stats_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);

-- api_keys -> organizations
ALTER TABLE api_keys ADD CONSTRAINT fk_api_keys_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- webhook_urls -> organizations
ALTER TABLE webhook_urls ADD CONSTRAINT fk_webhook_urls_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- webhook_delivery_logs -> webhook_urls, organizations, domains
ALTER TABLE webhook_delivery_logs ADD CONSTRAINT fk_webhook_delivery_url
    FOREIGN KEY (webhook_url_id) REFERENCES webhook_urls(id);
ALTER TABLE webhook_delivery_logs ADD CONSTRAINT fk_webhook_delivery_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);
ALTER TABLE webhook_delivery_logs ADD CONSTRAINT fk_webhook_delivery_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);

-- alerts -> organizations, domains, email_accounts
ALTER TABLE alerts ADD CONSTRAINT fk_alerts_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);
ALTER TABLE alerts ADD CONSTRAINT fk_alerts_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);
ALTER TABLE alerts ADD CONSTRAINT fk_alerts_email_account
    FOREIGN KEY (email_account_id) REFERENCES email_accounts(id);

-- usage_history -> organizations, domains, email_accounts
ALTER TABLE usage_history ADD CONSTRAINT fk_usage_history_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);
ALTER TABLE usage_history ADD CONSTRAINT fk_usage_history_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);
ALTER TABLE usage_history ADD CONSTRAINT fk_usage_history_email_account
    FOREIGN KEY (email_account_id) REFERENCES email_accounts(id);

-- ssl_certificates -> domains
ALTER TABLE ssl_certificates ADD CONSTRAINT fk_ssl_certs_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);

-- dkim_keys -> domains
ALTER TABLE dkim_keys ADD CONSTRAINT fk_dkim_keys_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);

-- ai_transactions -> organizations
ALTER TABLE ai_transactions ADD CONSTRAINT fk_ai_transactions_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- email_suppressions -> organizations
ALTER TABLE email_suppressions ADD CONSTRAINT fk_email_suppressions_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- domain_reputation -> domains, organizations
ALTER TABLE domain_reputation ADD CONSTRAINT fk_domain_reputation_domain
    FOREIGN KEY (domain_id) REFERENCES domains(id);
ALTER TABLE domain_reputation ADD CONSTRAINT fk_domain_reputation_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- feedback_loops -> organizations
ALTER TABLE feedback_loops ADD CONSTRAINT fk_feedback_loops_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- analytics_data -> organizations
ALTER TABLE analytics_data ADD CONSTRAINT fk_analytics_data_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id);

-- ip_access_rules -> organizations
ALTER TABLE ip_access_rules ADD CONSTRAINT fk_ip_rules_org
    FOREIGN KEY (organization_id) REFERENCES organizations(id) ON DELETE CASCADE;

-- shared_mailbox_members -> email_accounts (both)
ALTER TABLE shared_mailbox_members ADD CONSTRAINT fk_shared_mailbox
    FOREIGN KEY (shared_mailbox_id) REFERENCES email_accounts(id) ON DELETE CASCADE;
