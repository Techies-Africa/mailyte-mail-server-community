-- =============================================================================
-- STEP 2: Migrate organizations.id from VARCHAR(100) to CHAR(26)
-- =============================================================================
-- Organizations use VARCHAR(100) user-supplied IDs (e.g. 'acme-corp').
-- We keep existing values (they fit in CHAR(26) if <= 26 chars; longer ones
-- need to be truncated or remapped). For safety we just change the column type.
-- New orgs will use application-generated ULIDs.

ALTER TABLE organizations MODIFY COLUMN id CHAR(26) NOT NULL;
ALTER TABLE organizations MODIFY COLUMN parent_organization_id CHAR(26) NULL;


-- =============================================================================
-- STEP 3: Migrate INT/BIGINT primary keys to CHAR(26)
-- =============================================================================
-- For each table: add new_id, populate with generated ULIDs, then swap.

-- -------------------------
-- 3a. domains
-- -------------------------
ALTER TABLE domains ADD COLUMN new_id CHAR(26) NULL AFTER id;
UPDATE domains SET new_id = generate_ulid_backfill() WHERE new_id IS NULL;
-- Update all FK references pointing to domains.id
UPDATE email_accounts ea JOIN domains d ON ea.domain_id = d.id SET ea.domain_id = 0;
-- We need a mapping table approach — use a temp column strategy instead
-- Actually, let's use a different approach: update FK columns via JOIN

-- First, add new FK columns in referencing tables
ALTER TABLE email_accounts ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE aliases ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE dkim_keys ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE ssl_certificates ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE email_tracking ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE tracking_statistics ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE webhook_delivery_logs ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE alerts ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE usage_history ADD COLUMN new_domain_id CHAR(26) NULL;
ALTER TABLE domain_reputation ADD COLUMN new_domain_id CHAR(26) NULL;

-- Populate new FK columns from the mapping
UPDATE email_accounts ea JOIN domains d ON ea.domain_id = d.id SET ea.new_domain_id = d.new_id;
UPDATE aliases a JOIN domains d ON a.domain_id = d.id SET a.new_domain_id = d.new_id;
UPDATE dkim_keys dk JOIN domains d ON dk.domain_id = d.id SET dk.new_domain_id = d.new_id;
UPDATE ssl_certificates sc JOIN domains d ON sc.domain_id = d.id SET sc.new_domain_id = d.new_id;
UPDATE email_tracking et JOIN domains d ON et.domain_id = d.id SET et.new_domain_id = d.new_id;
UPDATE tracking_statistics ts JOIN domains d ON ts.domain_id = d.id SET ts.new_domain_id = d.new_id;
UPDATE webhook_delivery_logs wdl JOIN domains d ON wdl.domain_id = d.id SET wdl.new_domain_id = d.new_id;
UPDATE alerts al JOIN domains d ON al.domain_id = d.id SET al.new_domain_id = d.new_id WHERE al.domain_id IS NOT NULL;
UPDATE usage_history uh JOIN domains d ON uh.domain_id = d.id SET uh.new_domain_id = d.new_id WHERE uh.domain_id IS NOT NULL;
UPDATE domain_reputation dr JOIN domains d ON dr.domain_id = d.id SET dr.new_domain_id = d.new_id;

-- Now swap columns on domains table
ALTER TABLE domains DROP COLUMN id;
ALTER TABLE domains CHANGE COLUMN new_id id CHAR(26) NOT NULL;
ALTER TABLE domains ADD PRIMARY KEY (id);

-- Swap domain_id FK columns in referencing tables
ALTER TABLE email_accounts DROP COLUMN domain_id;
ALTER TABLE email_accounts CHANGE COLUMN new_domain_id domain_id CHAR(26) NOT NULL;

ALTER TABLE aliases DROP COLUMN domain_id;
ALTER TABLE aliases CHANGE COLUMN new_domain_id domain_id CHAR(26) NOT NULL;

ALTER TABLE dkim_keys DROP COLUMN domain_id;
ALTER TABLE dkim_keys CHANGE COLUMN new_domain_id domain_id CHAR(26) NOT NULL;

ALTER TABLE ssl_certificates DROP COLUMN domain_id;
ALTER TABLE ssl_certificates CHANGE COLUMN new_domain_id domain_id CHAR(26) NOT NULL;

ALTER TABLE email_tracking DROP COLUMN domain_id;
ALTER TABLE email_tracking CHANGE COLUMN new_domain_id domain_id CHAR(26) NOT NULL;

ALTER TABLE tracking_statistics DROP COLUMN domain_id;
ALTER TABLE tracking_statistics CHANGE COLUMN new_domain_id domain_id CHAR(26) NOT NULL;

ALTER TABLE webhook_delivery_logs DROP COLUMN domain_id;
ALTER TABLE webhook_delivery_logs CHANGE COLUMN new_domain_id domain_id CHAR(26) NULL;

