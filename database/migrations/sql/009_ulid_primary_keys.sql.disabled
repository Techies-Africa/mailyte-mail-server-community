-- =============================================================================
-- Migration 009: ULID Primary Keys
-- =============================================================================
-- Migrates ALL tables from INT AUTO_INCREMENT / VARCHAR(100) primary keys
-- to CHAR(26) ULID (Universally Unique Lexicographically Sortable Identifier).
--
-- ULIDs are 26-character strings generated in application code. They are:
--   - Globally unique (no collisions across distributed systems)
--   - Lexicographically sortable by creation time
--   - URL-safe (Crockford Base32)
--
-- Strategy:
--   1. Create a SQL helper function to generate ULID-like values for backfill
--   2. Drop ALL foreign key constraints
--   3. For INT/BIGINT PKs: add new_id CHAR(26), populate, drop old id, rename
--   4. For VARCHAR(100) PKs (organizations): ALTER COLUMN to CHAR(26)
--   5. Alter all foreign key columns to CHAR(26)
--   6. Re-add all foreign key constraints
--
-- WARNING: This is a destructive migration. Back up your database first.
-- Depends on: 008_missing_tables.sql
-- =============================================================================

-- =============================================================================
-- STEP 0: ULID generation helper for backfilling existing rows
-- =============================================================================
-- This generates a 26-char Crockford Base32 string. It is NOT a true ULID
-- (no embedded timestamp) but is sufficient for backfilling existing rows.
-- New rows will use real ULIDs generated by the Python application layer.

DELIMITER $$

DROP FUNCTION IF EXISTS generate_ulid_backfill$$

CREATE FUNCTION generate_ulid_backfill()
RETURNS CHAR(26) DETERMINISTIC
BEGIN
    DECLARE chars VARCHAR(32) DEFAULT '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
    DECLARE result CHAR(26) DEFAULT '';
    DECLARE i INT DEFAULT 0;
    DECLARE rand_val BIGINT;

    -- Use a combination of timestamp and random for uniqueness
    SET rand_val = UNIX_TIMESTAMP(NOW(6)) * 1000000 + FLOOR(RAND() * 1000000);

    -- Generate 26 characters from Crockford Base32 alphabet
    WHILE i < 26 DO
        SET result = CONCAT(result, SUBSTRING(chars, FLOOR(RAND() * 32) + 1, 1));
        SET i = i + 1;
    END WHILE;

    RETURN result;
END$$

DELIMITER ;


-- =============================================================================
-- STEP 1: Drop ALL foreign key constraints
-- =============================================================================
-- We must drop every FK before altering column types.

-- domains -> organizations
ALTER TABLE domains DROP FOREIGN KEY fk_domains_org;

