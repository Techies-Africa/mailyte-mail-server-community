user = ${DB_USER}
password = ${DB_PASSWORD}
hosts = ${DB_HOST}:${DB_PORT}
dbname = ${DB_NAME}
query = SELECT email FROM email_accounts WHERE email='%s' AND status = 'active' UNION SELECT destination FROM aliases WHERE source='%s' AND active = 1 UNION SELECT sc.username FROM smtp_credentials sc JOIN domains d ON sc.domain_id = d.id WHERE d.domain = SUBSTRING_INDEX('%s', '@', -1) AND sc.active = 1
