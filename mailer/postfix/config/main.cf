
#
# Postfix Main Configuration File
#
# Static defaults are defined here. Environment-specific overrides are
# applied at startup by entrypoint.sh using `postconf -e`.
#

# =============================================================================
# SERVER IDENTIFICATION AND NETWORK
# =============================================================================

# Defaults — overridden by entrypoint.sh from $HOSTNAME env var
myhostname = mail.example.com
mydomain = example.com
myorigin = $mydomain

# Only accept local system mail (virtual domains handled separately)
mydestination = localhost

# Network configuration
inet_interfaces = all
inet_protocols = all

# Trusted networks — overridden by entrypoint.sh for Docker subnet
mynetworks = 127.0.0.0/8 [::1]/128

# Disable reverse DNS lookup on connecting clients — prevents hanging in Docker
# and improves connection speed. RBL checks still work via smtpd_client_restrictions.
smtpd_peername_lookup = no

# =============================================================================
# VIRTUAL DOMAINS CONFIGURATION
# All domain/user data is stored in MySQL database.
# proxy: prefix delegates lookups to the non-chrooted proxymap service,
# which is required because smtpd runs inside a chroot jail.
# =============================================================================

virtual_mailbox_domains = proxy:mysql:/etc/postfix/mysql-virtual-mailbox-domains.cf
virtual_mailbox_maps = proxy:mysql:/etc/postfix/mysql-virtual-mailbox-maps.cf
virtual_alias_maps = proxy:mysql:/etc/postfix/mysql-virtual-alias-maps.cf

# Sender login maps — controls which SASL users can send as which addresses
# Required by reject_sender_login_mismatch in submission/smtps services
smtpd_sender_login_maps = proxy:mysql:/etc/postfix/mysql-sender-login-maps.cf

# Base directory where all virtual mailboxes are stored
virtual_mailbox_base = /var/mail/vhosts

# Virtual mailbox ownership (vmail user uid/gid 5000)
virtual_minimum_uid = 100
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

# Proxymap read permissions — list all maps that proxymap is allowed to serve
proxy_read_maps = $virtual_mailbox_domains $virtual_mailbox_maps
    $virtual_alias_maps $smtpd_sender_login_maps
    proxy:unix:passwd.byname $local_recipient_maps

# =============================================================================
# SMTP PROTOCOL CONFIGURATION
# =============================================================================

# Custom SMTP banner (hide version info)
smtpd_banner = $myhostname ESMTP

# Require HELO/EHLO before other commands (anti-spam)
smtpd_helo_required = yes

# SMTP Smuggling Protection (CVE-2023-51764)
smtpd_forbid_bare_newline = reject
smtpd_forbid_bare_newline_exclusions =

# Disable VRFY/ETRN — prevents email enumeration and abuse
disable_vrfy_command = yes
disable_etrn_command = yes

# Delay rejection — collect more info before rejecting (better RBL accuracy)
smtpd_delay_reject = yes

biff = no
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6

# =============================================================================
# TLS/SSL ENCRYPTION CONFIGURATION
# Defaults here; override via POSTFIX_TLS_* env vars in entrypoint.sh
# =============================================================================

smtpd_tls_cert_file = /etc/ssl/certs/server.crt
smtpd_tls_key_file = /etc/ssl/private/server.key

# SNI — per-domain cert lookup for enterprise custom hostnames
# Format: hash map of "hostname /path/to/key /path/to/cert"
# Built at startup by entrypoint.sh from /etc/ssl/sni/postfix_sni.map
# cert_manager rebuilds and signals SIGHUP after each new cert issuance
tls_server_sni_maps = hash:/etc/postfix/sni_certs.map

# Inbound: opportunistic TLS (may); Outbound: opportunistic TLS
smtpd_tls_security_level = may
smtp_tls_security_level = may

# Require SASL auth only over TLS
smtpd_tls_auth_only = yes

# TLSv1.2+ only, strong ciphers
smtpd_tls_protocols = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtp_tls_protocols = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtpd_tls_ciphers = high
smtp_tls_ciphers = high
smtpd_tls_exclude_ciphers = aNULL, MD5, DES, RC4, 3DES, ADH, EXPORT, LOW

# TLS session caching
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtpd_tls_session_cache_timeout = 3600s

# TLS logging
smtpd_tls_loglevel = 1
smtp_tls_note_starttls_offer = yes

# =============================================================================
# SASL AUTHENTICATION — Dovecot via TCP (cross-container)
# Dovecot must expose auth on port 24100 (configured in dovecot.conf)
# =============================================================================

smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:24100
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname

# =============================================================================
# ACCESS CONTROL AND ANTI-SPAM RESTRICTIONS
# =============================================================================

# CLIENT CONNECTION RESTRICTIONS
# Order: mynetworks → SASL → pipelining check → RBLs (8 sources) → hostname check
smtpd_client_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_pipelining,
    reject_rbl_client zen.spamhaus.org,
    reject_rbl_client bl.spamcop.net,
    reject_rbl_client dnsbl.sorbs.net,
    reject_rbl_client psbl.surriel.com,
    reject_rbl_client b.barracudacentral.org,
    reject_rbl_client dnsbl-1.uceprotect.net,
    reject_rbl_client cbl.abuseat.org,
    reject_rbl_client dnsbl.dronebl.org,
    warn_if_reject reject_unknown_client_hostname

# RECIPIENT RESTRICTIONS
# Order: mynetworks → SASL → validation → RBL → per-org IP policy → rate limit
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unauth_destination,
    reject_unlisted_recipient,
    reject_rbl_client zen.spamhaus.org,
    check_policy_service unix:private/policy-ip-access,
    permit

# Named restriction class so the submission service's master.cf override
# (port 587) can reference the same rate-limit policy check by a
# whitespace-free name -- ported from mailyte-email-server
# (01-mailyte-email-server/phase-10-smtp-credential-auth.md), same bug
# confirmed present here: master.cf's own -o argument parser splits an
# unquoted value on whitespace, so a literal
# "check_policy_service unix:private/policy-rate-limit" there becomes two
# broken tokens and crashes smtpd on every startup. This repo had the exact
# same never-substituted "${whitespace}" placeholder as EE.
smtpd_restriction_classes = submission_rate_limit_check
submission_rate_limit_check = check_policy_service unix:private/policy-rate-limit

# SENDER RESTRICTIONS
# reject_sender_login_mismatch MUST come before permit_sasl_authenticated --
# ported fix from mailyte-email-server, same pre-existing bug confirmed
# present here (permit_sasl_authenticated first made the mismatch check
# dead for every authenticated sender). See
# 00-foundation memory note postfix_sender_login_mismatch_not_enforced.md --
# even with this ordering fixed, live testing on the EE sibling showed the
# mismatch still isn't rejecting; root cause unresolved. Fixed here anyway
# since leaving the ordering wrong is strictly worse, but don't treat
# "authenticated senders can only send as their own address" as a working
# guarantee on this system yet.
smtpd_sender_restrictions =
    permit_mynetworks,
    reject_sender_login_mismatch,
    permit_sasl_authenticated,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain

# HELO/EHLO RESTRICTIONS
smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_helo_hostname,
    reject_invalid_helo_hostname,
    warn_if_reject reject_unknown_helo_hostname

# DATA PHASE RESTRICTIONS
#
# The rate limiter is consulted HERE AND NOWHERE ELSE -- ported from the EE
# sibling, where the lesson cost an inbound outage: it used to run in three
# lists at once (sender, recipient and data restrictions), each call posts
# record:true, so one message incremented the same counter three times
# inside one second and per-second limits deferred essentially every
# unauthenticated inbound message. It only hit unauthenticated mail because
# permit_mynetworks/permit_sasl_authenticated short-circuit ahead of the
# policy in the other two lists -- outbound looked fine while inbound
# stopped. DATA runs once per message, which is the unit the caps mean.
# Adding this policy to any other list re-creates the outage.
smtpd_data_restrictions =
    reject_unauth_pipelining,
    reject_multi_recipient_bounce,
    check_policy_service unix:private/policy-rate-limit

# HEADER AND BODY CHECKS (files created empty by Dockerfile)
header_checks = regexp:/etc/postfix/header_checks
body_checks = regexp:/etc/postfix/body_checks
mime_header_checks = regexp:/etc/postfix/mime_header_checks

# RELAY RESTRICTIONS
# permit_mynetworks allows internal Docker containers to deliver to LOCAL domains only.
# External relay requires SASL authentication (port 587).
# reject_unauth_destination blocks relay to non-local domains without auth.
smtpd_relay_restrictions =
    permit_sasl_authenticated,
    reject_unauth_destination

# =============================================================================
# PERFORMANCE AND RATE LIMITING
# Defaults here; override via POSTFIX_* env vars in entrypoint.sh
# =============================================================================

message_size_limit = 52428800
mailbox_size_limit = 0
default_process_limit = 100

# Rate limiting
smtpd_client_connection_rate_limit = 30
smtpd_client_connection_count_limit = 50
smtpd_client_message_rate_limit = 100
smtpd_client_recipient_rate_limit = 200
anvil_rate_time_unit = 60s

# SMTP timeouts
smtpd_timeout = 300s
smtpd_helo_timeout = 60s
smtpd_mail_timeout = 300s
smtpd_rcpt_timeout = 300s
smtpd_data_timeout = 600s

# Error handling
smtpd_soft_error_limit = 10
smtpd_hard_error_limit = 20
smtpd_junk_command_limit = 10
smtpd_reject_footer = Contact postmaster@$mydomain for assistance
smtp_dns_timeout = 30s

# =============================================================================
# POSTSCREEN — Pre-SMTP deep filtering
# Rejects ~80% of spam bots before they reach smtpd
# =============================================================================

# DNSBL checks (same as smtpd_client_restrictions but pre-connection)
postscreen_dnsbl_sites =
    zen.spamhaus.org*3,
    b.barracudacentral.org*2,
    bl.spamcop.net*2,
    dnsbl.sorbs.net*1,
    psbl.surriel.com*1
postscreen_dnsbl_threshold = 3
postscreen_dnsbl_action = enforce

# Pregreet detection — bots that talk before the banner
postscreen_greet_action = enforce
postscreen_greet_wait = 3s

# Non-SMTP command detection
postscreen_non_smtp_command_enable = yes
postscreen_non_smtp_command_action = enforce

# Bare newline detection
postscreen_bare_newline_enable = yes
postscreen_bare_newline_action = enforce

# Pipelining detection
postscreen_pipelining_enable = yes
postscreen_pipelining_action = enforce

# Whitelist — Docker subnet and established clients
postscreen_access_list = permit_mynetworks
postscreen_dnsbl_whitelist_threshold = -1

# Cache for known-good clients (10 days)
postscreen_cache_map = btree:$data_directory/postscreen_cache
postscreen_cache_cleanup_interval = 12h
postscreen_cache_retention_time = 10d

# =============================================================================
# VIRTUAL TRANSPORT — Deliver to Dovecot via LMTP
# Dovecot handles quota enforcement, Sieve filtering, FTS indexing
# =============================================================================

virtual_transport = lmtp:inet:dovecot:24

# =============================================================================
# MILTER INTEGRATION — Rspamd for spam filtering and DKIM signing
# =============================================================================

smtpd_milters = inet:rspamd:11332
non_smtpd_milters = inet:rspamd:11332
milter_protocol = 6
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
milter_default_action = accept
