
#
# Postfix Main Configuration File
#
# Static defaults are defined here. Environment-specific overrides are
# applied at startup by entrypoint.sh using `postconf -e`.
#

# =============================================================================
# SERVER IDENTIFICATION AND NETWORK
# =============================================================================

# Defaults — overridden by entrypoint.sh from $HOSTNAME env var
myhostname = mail.example.com
mydomain = example.com
myorigin = $mydomain

# Only accept local system mail (virtual domains handled separately)
mydestination = localhost

# Network configuration
inet_interfaces = all
inet_protocols = all

# Trusted networks — overridden by entrypoint.sh for Docker subnet
mynetworks = 127.0.0.0/8 [::1]/128

# Disable reverse DNS lookup on connecting clients — prevents hanging in Docker
# and improves connection speed. RBL checks still work via smtpd_client_restrictions.
smtpd_peername_lookup = no

# =============================================================================
# VIRTUAL DOMAINS CONFIGURATION
# All domain/user data is stored in MySQL database.
# proxy: prefix delegates lookups to the non-chrooted proxymap service,
# which is required because smtpd runs inside a chroot jail.
# =============================================================================

virtual_mailbox_domains = proxy:mysql:/etc/postfix/mysql-virtual-mailbox-domains.cf
virtual_mailbox_maps = proxy:mysql:/etc/postfix/mysql-virtual-mailbox-maps.cf
virtual_alias_maps = proxy:mysql:/etc/postfix/mysql-virtual-alias-maps.cf

# Sender login maps — controls which SASL users can send as which addresses
# Required by reject_sender_login_mismatch in submission/smtps services
smtpd_sender_login_maps = proxy:mysql:/etc/postfix/mysql-sender-login-maps.cf

# Base directory where all virtual mailboxes are stored
virtual_mailbox_base = /var/mail/vhosts

# Virtual mailbox ownership (vmail user uid/gid 5000)
virtual_minimum_uid = 100
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

# Proxymap read permissions — list all maps that proxymap is allowed to serve
proxy_read_maps = $virtual_mailbox_domains $virtual_mailbox_maps
    $virtual_alias_maps $smtpd_sender_login_maps
    proxy:unix:passwd.byname $local_recipient_maps

# =============================================================================
# SMTP PROTOCOL CONFIGURATION
# =============================================================================

# Custom SMTP banner (hide version info)
smtpd_banner = $myhostname ESMTP

# Require HELO/EHLO before other commands (anti-spam)
smtpd_helo_required = yes

# SMTP Smuggling Protection (CVE-2023-51764)
smtpd_forbid_bare_newline = reject
smtpd_forbid_bare_newline_exclusions =

# Disable VRFY/ETRN — prevents email enumeration and abuse
disable_vrfy_command = yes
disable_etrn_command = yes

# Delay rejection — collect more info before rejecting (better RBL accuracy)
smtpd_delay_reject = yes

biff = no
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6

# =============================================================================
# TLS/SSL ENCRYPTION CONFIGURATION
# Defaults here; override via POSTFIX_TLS_* env vars in entrypoint.sh
# =============================================================================

smtpd_tls_cert_file = /etc/ssl/certs/server.crt
smtpd_tls_key_file = /etc/ssl/private/server.key

# SNI — per-domain cert lookup for enterprise custom hostnames
# Format: hash map of "hostname /path/to/key /path/to/cert"
# Built at startup by entrypoint.sh from /etc/ssl/sni/postfix_sni.map
# cert_manager rebuilds and signals SIGHUP after each new cert issuance
tls_server_sni_maps = hash:/etc/postfix/sni_certs.map

# Inbound: opportunistic TLS (may); Outbound: opportunistic TLS
smtpd_tls_security_level = may
smtp_tls_security_level = may

# Require SASL auth only over TLS
smtpd_tls_auth_only = yes

# TLSv1.2+ only, strong ciphers
smtpd_tls_protocols = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtp_tls_protocols = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtpd_tls_ciphers = high
smtp_tls_ciphers = high
smtpd_tls_exclude_ciphers = aNULL, MD5, DES, RC4, 3DES, ADH, EXPORT, LOW

# TLS session caching
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtpd_tls_session_cache_timeout = 3600s

# TLS logging
smtpd_tls_loglevel = 1
smtp_tls_note_starttls_offer = yes

# =============================================================================
# SASL AUTHENTICATION — Dovecot via TCP (cross-container)
# Dovecot must expose auth on port 24100 (configured in dovecot.conf)
# =============================================================================

smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:24100
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname

# =============================================================================
# ACCESS CONTROL AND ANTI-SPAM RESTRICTIONS
# =============================================================================

# CLIENT CONNECTION RESTRICTIONS
# Order: mynetworks → SASL → pipelining check → RBL → hostname check
#
# ONE blocklist here, deliberately. This used to stack eight, each as an
# outright reject, so any single list could veto a message on its own -- and
# aggressive lists routinely list the shared IPs that ESPs send legitimate
# transactional mail from.
#
# Measured, not assumed: Anthropic's own senders (168.245.101.254 and
# 168.245.100.91, both reverse-resolving to *.mail.anthropic.com) were
# rejected here while appearing on NO other list -- bl.spamcop.net alone.
# The same stack blocked routine delivery-test services. Mail from Gmail got
# through and everything else quietly did not, which is a very hard shape of
# outage to notice.
#
# The removed lists are not equivalent to zen: cbl.abuseat.org is already
# inside zen (redundant), dnsbl-1.uceprotect.net lists entire ISP ranges to
# pressure providers, sorbs is long unreliable, and spamcop/psbl churn fast
# enough that a listing says little about a given message.
#
# Defence in depth is kept, just not as a hair trigger: postscreen still
# consults five lists with WEIGHTED scores against a threshold
# (postscreen_dnsbl_sites below), so a single mid-confidence listing costs a
# sender points rather than the message.
smtpd_client_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_pipelining,
    reject_rbl_client zen.spamhaus.org,
    warn_if_reject reject_unknown_client_hostname

# RECIPIENT RESTRICTIONS
# Order: mynetworks → SASL → validation → RBL → per-org IP policy → rate limit
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unauth_destination,
    reject_unlisted_recipient,
    reject_rbl_client zen.spamhaus.org,
    check_policy_service unix:private/policy-ip-access,
    permit

# Named restriction class so the submission service's master.cf override
# (port 587) can reference the same rate-limit policy check by a
# whitespace-free name -- master.cf's own -o argument parser splits an
# unquoted value on whitespace, so a literal
# "check_policy_service unix:private/policy-rate-limit" there becomes two
# broken tokens ("...,check_policy_service" and a bare, flag-less
# "unix:private/policy-rate-limit,reject") and crashes smtpd on every
# startup ("fatal: unexpected command-line argument"). Confirmed live via
# mail.log while verifying the SMTP-credentials workstream -- this was
# pre-existing and unrelated to that workstream, found because it blocked
# testing it end to end. A previous attempt at this same override
# apparently tried to solve the same problem by embedding a literal
# "${whitespace}" placeholder with no substitution step defined anywhere
# in this repo -- dead since it was written.
smtpd_restriction_classes = submission_rate_limit_check
submission_rate_limit_check = check_policy_service unix:private/policy-rate-limit

# SENDER RESTRICTIONS
#
# reject_sender_login_mismatch MUST NOT appear here. This is the GLOBAL value,
# and the `smtp inet` service (port 25) has no override in master.cf, so it
# inherits whatever is set here. Port 25 carries unauthenticated mail from the
# public internet by definition -- so the mismatch check fires on any inbound
# message whose envelope sender happens to own a mailbox on this server, and
# rejects legitimate mail with:
#
#   553 5.7.1 <user@ourdomain>: Sender address rejected: not logged in
#
# That broke inbound mail in production on 2026-08-22: mail from
# devops@techies.africa to support@tmahelp.ng was rejected outright, because
# devops@techies.africa resolves to an owner in smtpd_sender_login_maps while
# the inbound SMTP session is (correctly) not authenticated. Any sender with a
# local mailbox was affected, which includes cross-domain mail between all of
# the hosted domains. Senders with no local mailbox (e.g. postmaster@) were
# unaffected, which is what made the bug easy to miss when spot-checking.
#
# Sender-ownership enforcement belongs ONLY on the authenticated submission
# paths, and master.cf already has it there, ahead of permit_sasl_authenticated
# so it is not short-circuited:
#
#   submission (587) -o smtpd_sender_restrictions=reject_sender_login_mismatch,permit_sasl_authenticated,reject
#   smtps      (465) -o smtpd_sender_restrictions=reject_sender_login_mismatch,permit_sasl_authenticated,reject
#
# Ordering still matters in those overrides: Postfix evaluates restrictions in
# order and stops at the first permit/reject, so permit_sasl_authenticated
# placed first would make the mismatch check dead code (the original 2026-08-07
# finding). Keep the mismatch check first there -- just not here.
smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain

# HELO/EHLO RESTRICTIONS
smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_helo_hostname,
    reject_invalid_helo_hostname,
    warn_if_reject reject_unknown_helo_hostname

# DATA PHASE RESTRICTIONS
#
# The rate limiter is consulted HERE AND NOWHERE ELSE on the inbound path.
#
# It used to run in three lists at once -- sender, recipient and data
# restrictions -- and each call posts record:true, so one message incremented
# the same counter three times inside one second. Against a per-second limit
# of 1 the first check passed and the second always failed, so essentially
# every inbound message was deferred with
# "450 4.7.1 Rate limit exceeded for <sender>". It only hit unauthenticated
# mail, because permit_mynetworks/permit_sasl_authenticated short-circuit
# ahead of the policy in the other two lists -- which is why outbound looked
# fine while inbound stopped for hours.
#
# DATA is the right single place: it runs once per message, which matches a
# limiter keyed on the sender. Adding this line to another list re-creates
# the outage.
smtpd_data_restrictions =
    reject_unauth_pipelining,
    reject_multi_recipient_bounce,
    check_policy_service unix:private/policy-rate-limit

# HEADER AND BODY CHECKS (files created empty by Dockerfile)
header_checks = regexp:/etc/postfix/header_checks
body_checks = regexp:/etc/postfix/body_checks
mime_header_checks = regexp:/etc/postfix/mime_header_checks

# RELAY RESTRICTIONS
#
# permit_mynetworks is REQUIRED here, not an oversight. Omitting it (the
# previous config) meant the only way to relay to an external address was SASL
# on 587 -- but the webmail does not use SASL. worker/api/routes/mailbox.py
# submits over the Docker network deliberately, because no user password is
# stored anywhere to authenticate with; that endpoint enforces the From address
# itself. So every message a user sent to an outside address was rejected with
# "554 5.7.1 Relay access denied" while the app reported the mail server had
# refused the recipient.
#
# The exposure this opens is bounded: $mynetworks is 127.0.0.0/8, [::1]/128 and
# the internal Docker subnet 172.25.0.0/16 -- no publicly routable range, and
# the host's mail ports are bound to loopback. Anything that can reach it is
# already a container in this compose stack. This is also Postfix's own default
# ordering.
#
# Do NOT widen $mynetworks to a public range: that is what turns this line into
# an open relay.
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

# =============================================================================
# PERFORMANCE AND RATE LIMITING
# Defaults here; override via POSTFIX_* env vars in entrypoint.sh
# =============================================================================

message_size_limit = 52428800
mailbox_size_limit = 0
default_process_limit = 100

# Rate limiting
smtpd_client_connection_rate_limit = 30
smtpd_client_connection_count_limit = 50
smtpd_client_message_rate_limit = 100
smtpd_client_recipient_rate_limit = 200
anvil_rate_time_unit = 60s

# SMTP timeouts
smtpd_timeout = 300s
smtpd_helo_timeout = 60s
smtpd_mail_timeout = 300s
smtpd_rcpt_timeout = 300s
smtpd_data_timeout = 600s

# Error handling
smtpd_soft_error_limit = 10
smtpd_hard_error_limit = 20
smtpd_junk_command_limit = 10
smtpd_reject_footer = Contact postmaster@$mydomain for assistance
smtp_dns_timeout = 30s

# =============================================================================
# POSTSCREEN — Pre-SMTP deep filtering
# Rejects ~80% of spam bots before they reach smtpd
# =============================================================================

# DNSBL checks (same as smtpd_client_restrictions but pre-connection)
postscreen_dnsbl_sites =
    zen.spamhaus.org*3,
    b.barracudacentral.org*2,
    bl.spamcop.net*2,
    dnsbl.sorbs.net*1,
    psbl.surriel.com*1
postscreen_dnsbl_threshold = 3
postscreen_dnsbl_action = enforce

# Pregreet detection — bots that talk before the banner
postscreen_greet_action = enforce
postscreen_greet_wait = 3s

# --- "after-220" deep protocol tests: DELIBERATELY DISABLED -------------------
#
# These three ran with action=enforce and were rejecting real mail. They cannot
# be evaluated before the SMTP greeting, so postscreen defers the delivery
# attempt with "450 4.3.2 Service currently unavailable" and allowlists the
# client, expecting the RETRY to get through.
#
# That assumption breaks on every large sender. The allowlist is keyed by IP,
# and Gmail retries from a different IP each time -- observed here as four
# attempts from 209.85.210.181, 209.85.160.49, 209.85.216.41 and
# 209.85.214.173, each one PASS NEW'd and each one rejected. Mail from Gmail
# could not arrive at all.
#
# Postfix ships all three OFF by default and POSTSCREEN_README warns that
# clients which do not retry from the same address will lose mail. The pre-220
# tests above (pregreet + DNSBL) carry the real spam-blocking load and cost a
# legitimate sender nothing, so they stay on.
postscreen_non_smtp_command_enable = no
postscreen_bare_newline_enable = no
postscreen_pipelining_enable = no

# Whitelist — Docker subnet and established clients
postscreen_access_list = permit_mynetworks
postscreen_dnsbl_whitelist_threshold = -1

# Cache for known-good clients (10 days)
postscreen_cache_map = btree:$data_directory/postscreen_cache
postscreen_cache_cleanup_interval = 12h
postscreen_cache_retention_time = 10d

# =============================================================================
# VIRTUAL TRANSPORT — Deliver to Dovecot via LMTP
# Dovecot handles quota enforcement, Sieve filtering, FTS indexing
# =============================================================================

virtual_transport = lmtp:inet:dovecot:24

# =============================================================================
# MILTER INTEGRATION — Rspamd for spam filtering and DKIM signing
# =============================================================================

smtpd_milters = inet:rspamd:11332
non_smtpd_milters = inet:rspamd:11332
milter_protocol = 6
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
milter_default_action = accept

# =============================================================================
# ENVIRONMENT PASSTHROUGH — for custom pipe/spawn transports
# =============================================================================
# Postfix does NOT hand its own container environment to pipe/spawn child
# processes (scripts/tracking_injector.py, the policy-ip-access service in
# master.cf) -- only import_environment's own explicit allowlist, which
# defaults to a minimal safe set (MAIL_CONFIG, TZ, LANG, ...). Confirmed
# live: tracking_injector.py silently fell back to DELIVERY_OPTIMIZER_URL's
# own built-in default (http://localhost:8088, meaningless inside this
# container) instead of the real value set in docker-compose.yml,
# deferring every single outbound message. Everything these two scripts
# actually read via os.getenv() needs to be listed here explicitly.
import_environment = MAIL_CONFIG MAIL_DEBUG MAIL_LOGTAG TZ XAUTHORITY DISPLAY LANG=C POSTLOG_SERVICE POSTLOG_HOSTNAME DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD DB_TIMEOUT REDIS_HOST REDIS_PORT TRACKING_SERVICE_URL TRACKING_ENABLED TRACKING_API_TIMEOUT TRACKING_WEBHOOK_URL TRACKING_WEBHOOK_TIMEOUT DELIVERY_OPTIMIZER_URL DELIVERY_OPTIMIZER_TIMEOUT DELIVERY_OPTIMIZER_FALLBACK_DELAY DEFAULT_ORGANIZATION_ID DEFAULT_DOMAIN_ID WEBHOOK_SECRET HOSTNAME

# =============================================================================
# LOGGING
#
# Postfix defaults to syslog, and nothing in this container runs a syslog
# daemon -- so mail logs went nowhere at all. No record of a delivery, a
# deferral, or a bounce, which is why delivery problems here could only be
# diagnosed by reproducing them by hand.
#
# /var/log/postfix is bind-mounted to logs/mailer/postfix on the host, so
# this puts the mail log somewhere a person can actually read it.
#
# Requires the `postlog` service in master.cf; Postfix refuses to start
# without it ("fatal: missing 'postlog' service in master.cf").
# =============================================================================
maillog_file = /var/log/postfix/mail.log

# =============================================================================
# CUTOVER ROUTING
#
# Domains migrated from mailcow exist in virtual_mailbox_domains here, which
# normally means "deliver locally". While a domain's MX still points at the
# old server (or, for some, at Microsoft 365 / Zoho), local delivery drops
# mail into this server's unread copy of the mailbox and it never reaches the
# real one. This map routes those domains by their real MX until each is cut
# over. See the file's own header for how to maintain it.
#
# The file lives in the mounted config dir (config/mailer/postfix/ on the
# host) rather than in this image, because which domains are cut over changes
# per deployment and over time -- but the setting has to be here, or it is
# lost the moment the container is recreated from the image.
# =============================================================================
# texthash: rather than hash: -- Postfix reads the plain file directly, so
# there is no compiled .db to generate, to forget, or to go missing. A missing
# hash: .db is not a soft failure: transport_maps lookup errors make Postfix
# reject EVERY sender with "451 4.3.0 Temporary lookup failure", which is
# exactly how all outbound mail stopped once a deployment wiped the map file.
transport_maps = texthash:/etc/postfix/custom/transport_cutover
