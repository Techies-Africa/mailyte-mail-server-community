#  -o milter_macro_daemon_name=ORIGINATING

# =============================================================================
# CORE POSTFIX SERVICES
# Essential services that handle mail processing, delivery, and management
# =============================================================================

# Mail pickup service - processes mail submitted via sendmail command
pickup    unix  n       -       y       60      1       pickup
# Wakes up every 60 seconds to check for new mail, max 1 process

# Cleanup service - processes and standardizes mail headers and format
cleanup   unix  n       -       y       -       0       cleanup
# No process limit (0 = unlimited), critical for mail processing

# Queue manager - manages mail delivery queues and retry logic
qmgr      unix  n       -       n       300     1       qmgr
# Wakes up every 300 seconds, exactly 1 process (queue manager is singleton)

# TLS session cache manager - manages TLS session resumption cache
tlsmgr    unix  -       -       y       1000?   1       tlsmgr
# Wakes up every 1000 seconds if needed (?), max 1 process

# Address rewriting service - canonicalizes addresses
rewrite   unix  -       -       y       -       -       trivial-rewrite

# Bounce message handling services
bounce    unix  -       -       y       -       0       bounce    # Hard bounces
defer     unix  -       -       y       -       0       bounce    # Soft bounces (temporary failures)
trace     unix  -       -       y       -       0       bounce    # Delivery status traces

# Address verification service - validates recipient addresses
verify    unix  -       -       y       -       1       verify

# Queue flushing service - forces immediate delivery attempts
flush     unix  n       -       y       1000?   0       flush

# Database lookup services
proxymap  unix  -       -       n       -       -       proxymap     # Database proxy
proxywrite unix -       -       n       -       1       proxymap     # Database write proxy

# =============================================================================
# MAIL TRANSPORT SERVICES
# Handle actual delivery of mail to various destinations
# =============================================================================

# SMTP transport - delivers mail to remote SMTP servers
smtp      unix  -       -       y       -       -       smtp

# Relay service - handles mail relaying through smart hosts
relay     unix  -       -       y       -       -       smtp

# Administrative services
showq     unix  n       -       y       -       -       showq      # Show mail queue
error     unix  -       -       y       -       -       error      # Error handling
retry     unix  -       -       y       -       -       error      # Retry handling
discard   unix  -       -       y       -       -       discard    # Discard mail

# Local delivery services
local     unix  -       n       n       -       -       local      # Local system users
virtual   unix  -       n       n       -       -       virtual    # Virtual mailbox users
lmtp      unix  -       -       y       -       -       lmtp       # LMTP delivery

# Infrastructure services
anvil     unix  -       -       y       -       1       anvil      # Connection/rate limiting
scache    unix  -       -       y       -       1       scache     # Connection caching

# =============================================================================
# WEBHOOK NOTIFICATION SYSTEM
# Sends HTTP notifications about mail events to external systems
# =============================================================================
webhook-filter unix -    n       n       -       -       pipe
  flags=Rq                                    # Restrict sender, quote local parts
  user=vmail                                  # Run as vmail user
  null_sender=                                # Handle null senders appropriately
  argv=/usr/local/bin/webhook_sender.py inbound  # Script to send webhooks

# =============================================================================
# RATE LIMITING POLICY SERVICE
# Enforces sending limits to prevent abuse and maintain reputation
# =============================================================================
policy-rate-limit unix -       n       n       -       -       spawn
  user=vmail                                  # Run as vmail user for database access
  argv=/usr/local/bin/rate_limit_policy.py   # Python script for rate limiting

# =============================================================================
# MAIL RE-INJECTION SERVICE (Alternative Configuration)
# Secondary service for re-injecting processed mail
# This duplicates the tracking-after service but on a different port
# =============================================================================
localhost:10026 inet n  -       y       -       -       smtpd
  # Identical configuration to 127.0.0.1:10026 above
  -o content_filter=                          # No content filtering
  -o receive_override_options=no_unknown_recipient_checks,no_header_body_checks,no_milters
  -o smtpd_helo_restrictions=                 # No restrictions for internal use
  -o smtpd_client_restrictions=               # No client restrictions
  -o smtpd_sender_restrictions=               # No sender restrictions
  -o smtpd_recipient_restrictions=permit_mynetworks,reject  # Allow only local network
  -o mynetworks=127.0.0.0/8                  # Define local network
  -o smtpd_authorized_xforward_hosts=127.0.0.0/8  # Allow XFORWARD from localhost

# =============================================================================
# CONFIGURATION NOTES AND BEST PRACTICES
# =============================================================================
# 
# SERVICE SCALING:
# - tracking-filter: Increased to 25 processes for high-volume tracking
# - Most services use default process limits appropriate for typical loads
# - Adjust maxproc values based on actual traffic patterns
#
# SECURITY CONSIDERATIONS:
# - All public services run in chroot jails where possible
# - Internal services drop privileges when appropriate
# - Rate limiting and connection controls prevent abuse
#
# MONITORING AND MAINTENANCE:
# - Each service writes to separate log files when configured
# - Use 'postfix status' to check service health
# - Use 'postconf -M' to verify master.cf syntax
# - Monitor process counts with 'ps aux | grep postfix'
#
# PERFORMANCE TUNING:
# - Increase maxproc for high-traffic services
# - Adjust wakeup timers based on mail volume
# - Monitor queue sizes and delivery times
# - Consider dedicated servers for high-volume installations
#
# TROUBLESHOOTING:
# - Check /var/log/maillog for service-specific errors
# - Use 'postfix reload' after configuration changes
# - Use 'postfix stop && postfix start' for major changes
# - Verify service startup with 'netstat -tlnp | grep :25'
# =============================================================================
