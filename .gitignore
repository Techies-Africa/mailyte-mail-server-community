# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root: these are Python build artefacts (setuptools
# writes ./lib and ./lib64), and unanchored they match ANY nested directory
# called lib -- which silently excluded scripts/lib/, the shared shell library
# backup.sh and restore.sh source at runtime. A deploy would have shipped
# scripts that immediately fail on a missing source file.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   https://pdm.fming.dev/#use-with-ide
.pdm.toml

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv

# Generated secrets -- KEK files (phase-07 C2), anything scripts/generate-secrets.sh
# writes here. Never committed; each environment generates its own.
/secrets/
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff -- CI runs it and so does anyone checking the lint ratchet locally, so
# its cache appears in every working tree. Carried up from the Community
# Edition's own .gitignore, which had this and this repo did not: CE is
# generated from here now, so a rule that lives only downstream is a rule that
# gets overwritten at the next release.
.ruff_cache/

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#.idea/

# ==========================================================================
# Mailyte project-specific
# ==========================================================================

# SSL certificates and private keys — NEVER commit these
storage/ssl_certs/*.crt
storage/ssl_certs/*.pem
storage/ssl_private/*.key
storage/ssl_private/*.pem
storage/sni_config/

# DKIM signing keys
storage/dkim_keys/

# Mail data
storage/mail_data/

# Attachments
storage/attachments/

# ACME HTTP-01 challenge files (transient, written by cert_manager)
storage/acme_challenge/

# api service's writable /app/data (bootstrap token, runtime state)
storage/api_data/

# Backups
storage/backups/*.sql
storage/backups/*.tar.gz

# Logs
logs/

# Diagnostic output
diagnostic_report.json

# Docker volumes
storage/qdrant_data/

# IDE
.idea/
.vscode/
*.swp
*.swo

.api-key
setup-first-user.sh

# Local dev overrides — port remaps depend on what else is running on the
# host (e.g. XAMPP on 80/443/3306). Commit docker-compose.override.yml.example
# instead; each developer copies it and adjusts for their own machine.
docker-compose.override.yml

# Bootstrap token (phase-02 task 2.4) -- single-use credential, never committed.
worker/api/data/

mailyte_dns_records.txt