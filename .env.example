# =============================================================================
# MAILYTE EMAIL SERVER — COMMUNITY EDITION
# Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mailserver
DB_USER=mailuser
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_db_password

# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# GENERAL EMAIL SERVER SETTINGS
# -----------------------------------------------------------------------------
HOSTNAME=mail.yourdomain.com
DOMAIN=yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/mail.crt
SSL_KEY_PATH=/etc/ssl/private/mail.key
ENABLE_TLS=true
TLS_PROTOCOLS=TLSv1.2,TLSv1.3

# -----------------------------------------------------------------------------
# POSTFIX CONFIGURATION
# -----------------------------------------------------------------------------
POSTFIX_MYHOSTNAME=mail.yourdomain.com
POSTFIX_MYDOMAIN=yourdomain.com
POSTFIX_MYORIGIN=$mydomain
POSTFIX_INET_INTERFACES=all
POSTFIX_INET_PROTOCOLS=ipv4

# Virtual mailbox settings
POSTFIX_VIRTUAL_MAILBOX_DOMAINS=mysql:/etc/postfix/mysql-virtual-mailbox-domains.cf
POSTFIX_VIRTUAL_MAILBOX_MAPS=mysql:/etc/postfix/mysql-virtual-mailbox-maps.cf
POSTFIX_VIRTUAL_ALIAS_MAPS=mysql:/etc/postfix/mysql-virtual-alias-maps.cf

# Message size limits
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
POSTFIX_MAILBOX_SIZE_LIMIT=1073741824

# Rate limiting
POSTFIX_ANVIL_RATE_TIME_UNIT=60s
POSTFIX_ANVIL_RATE_COUNT_MAX=20

# Security and filtering
POSTFIX_SMTPD_HELO_REQUIRED=yes
POSTFIX_SMTPD_DELAY_REJECT=yes
POSTFIX_DISABLE_VRFY_COMMAND=yes

# Content filtering
POSTFIX_CONTENT_FILTER=smtp-amavis:[127.0.0.1]:10024
POSTFIX_RECEIVE_OVERRIDE_OPTIONS=no_address_mappings

# Enhanced security settings
POSTFIX_SMTPD_SASL_SECURITY_OPTIONS=noanonymous,noplaintext
POSTFIX_SMTPD_SASL_TLS_SECURITY_OPTIONS=noanonymous
POSTFIX_SMTP_TLS_SECURITY_LEVEL=may
POSTFIX_SMTPD_TLS_SECURITY_LEVEL=may
POSTFIX_SMTP_TLS_NOTE_STARTTLS_OFFER=yes
POSTFIX_SMTPD_TLS_RECEIVED_HEADER=yes

# Header and body checks
POSTFIX_HEADER_CHECKS=regexp:/etc/postfix/header_checks
POSTFIX_BODY_CHECKS=regexp:/etc/postfix/body_checks
POSTFIX_MIME_HEADER_CHECKS=regexp:/etc/postfix/mime_header_checks

# Postfix runtime defaults
DEFAULT_TENANT_ID=
DEFAULT_DOMAIN_ID=

# -----------------------------------------------------------------------------
# DOVECOT CONFIGURATION
# -----------------------------------------------------------------------------
DOVECOT_MAIL_LOCATION=maildir:/var/mail/vhosts/%d/%n
DOVECOT_MAIL_PRIVILEGED_GROUP=mail
DOVECOT_FIRST_VALID_UID=1000
DOVECOT_LAST_VALID_UID=1000

# Authentication
DOVECOT_AUTH_MECHANISMS=plain login
DOVECOT_DISABLE_PLAINTEXT_AUTH=yes
DOVECOT_AUTH_SOCKET_PATH=/var/run/dovecot/auth-postfix

# SSL configuration
DOVECOT_SSL=required
DOVECOT_SSL_CERT_PATH=/etc/ssl/certs/mail.crt
DOVECOT_SSL_KEY_PATH=/etc/ssl/private/mail.key
DOVECOT_SSL_PROTOCOLS=!SSLv2 !SSLv3

# Logging
DOVECOT_AUTH_VERBOSE=yes
DOVECOT_AUTH_DEBUG=no
DOVECOT_MAIL_DEBUG=no

# -----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION
# -----------------------------------------------------------------------------
# Main webhook URLs (comma-separated for multiple webhooks). Point this at
# your own receiver -- CE ships no Laravel backend (ADR-001), so unlike the
# commercial mailyte-email-server repo there is no default Laravel receiver
# to suggest here. Whatever you set: docker-compose.yml also maps this same
# value onto WEBHOOK_URL (singular) for the `webhooks`/`tracking` services --
# shared/webhook_dispatcher.py reads that singular name, not this one, so a
# missing mapping (fixed 2026-08-01, see phase-07-tenant-surface.md task 7.0)
# would silently drop every event regardless of what you set here.
WEBHOOK_URLS=https://your-webhook-endpoint.com/webhook

# Webhook security
WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# Webhook behavior
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_BATCH_SIZE=50

# Webhook filtering by event type
WEBHOOK_ENABLED_EVENTS=email.smtp.inbound,email.smtp.outbound,email.imap.read,dovecot.auth.success

# Webhook delivery and cleanup
WEBHOOK_AUTO_CLEANUP_ENABLED=true
WEBHOOK_CLEANUP_INTERVAL_HOURS=6
WEBHOOK_DELETE_SUCCESSFUL_AFTER_HOURS=24
WEBHOOK_DELETE_FAILED_AFTER_HOURS=168
WEBHOOK_MAX_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY=5
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=2.0
WEBHOOK_RETRY_MAX_DELAY=3600

# -----------------------------------------------------------------------------
# EMAIL TRACKING CONFIGURATION
# -----------------------------------------------------------------------------
TRACKING_ENABLED=true
OPEN_TRACKING_ENABLED=true
CLICK_TRACKING_ENABLED=true

# Tracking domain configuration
TRACKING_DOMAIN=yourdomain.com
TRACKING_SUBDOMAIN=track
TRACKING_PROTOCOL=https
TRACKING_REQUIRE_SSL=true

# Pixel tracking settings
TRACKING_PIXEL_CACHE_CONTROL=no-cache, no-store, must-revalidate
TRACKING_PIXEL_EXPIRES=0

# Click tracking
CLICK_REDIRECT_TIMEOUT=30
CLICK_PRESERVE_QUERY_PARAMS=true
CLICK_PRESERVE_FRAGMENTS=true

# Database settings for tracking
TRACKING_BATCH_INSERT_SIZE=100
TRACKING_DB_POOL_SIZE=10
TRACKING_DB_TIMEOUT=30

# Tracking webhooks
TRACKING_WEBHOOK_ENABLED=true
TRACKING_WEBHOOK_TIMEOUT=10
TRACKING_WEBHOOK_RETRY_ATTEMPTS=3

# Privacy settings
TRACK_USER_AGENT=true
TRACK_IP_ADDRESS=true
TRACKING_ANONYMIZE_IP=false
TRACKING_DATA_RETENTION_DAYS=365

# Performance
TRACKING_ASYNC_LOGGING=true
TRACKING_CACHE_CONFIGS=true
TRACKING_CACHE_TTL=300

# Rate limiting
TRACKING_RATE_LIMIT_PER_IP=1000
TRACKING_RATE_LIMIT_WINDOW=3600

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# RATE LIMITING CONFIGURATION
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# Per-service rate limits
RATE_LIMIT_SMTP_PER_HOUR=100
RATE_LIMIT_IMAP_PER_HOUR=1000
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=100

# Rate Limiter Service
RATE_LIMITER_HOST=0.0.0.0
RATE_LIMITER_PORT=8082
RATE_LIMITER_DEBUG=false

# Rate limit alert thresholds (percentages)
RATE_LIMIT_WARNING_THRESHOLD=80
RATE_LIMIT_CRITICAL_THRESHOLD=95

# Default Rate Limits - Organization Level
ORG_OUTBOUND_HOURLY_DEFAULT=10000
ORG_OUTBOUND_DAILY_DEFAULT=100000
ORG_OUTBOUND_BURST_DEFAULT=2000

# Default Rate Limits - Domain Level
DOMAIN_OUTBOUND_HOURLY_DEFAULT=2000
DOMAIN_OUTBOUND_DAILY_DEFAULT=20000
DOMAIN_OUTBOUND_BURST_DEFAULT=500

# Default Rate Limits - Mailbox Level
MAILBOX_OUTBOUND_HOURLY_DEFAULT=200
MAILBOX_OUTBOUND_DAILY_DEFAULT=2000
MAILBOX_OUTBOUND_BURST_DEFAULT=100

# -----------------------------------------------------------------------------
# SPAM AND SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
RSPAMD_ENABLED=true
RSPAMD_HOST=rspamd
RSPAMD_PORT=11333

# Spam thresholds
SPAM_THRESHOLD_REJECT=15.0
SPAM_THRESHOLD_ADD_HEADER=6.0
SPAM_THRESHOLD_GREYLIST=4.0

# Security features
ENABLE_GREYLISTING=true
ENABLE_DKIM_SIGNING=true
ENABLE_SPF_CHECK=true
ENABLE_DMARC_CHECK=true

# Greylisting
GREYLISTING_ENABLED=true
GREYLIST_TIMEOUT=300
GREYLIST_EXPIRE=86400

# -----------------------------------------------------------------------------
# SSL CERTIFICATE MANAGER
# -----------------------------------------------------------------------------
ACME_EMAIL=admin@yourdomain.com
ACME_STAGING=false
CERT_RENEWAL_DAYS=30
CERT_CHECK_INTERVAL=21600

# -----------------------------------------------------------------------------
# PRIVATE KEY ENCRYPTION (DKIM / PGP / S-MIME)
# -----------------------------------------------------------------------------
# DKIM signing keys are envelope-encrypted (AES-256-GCM) before they are
# stored, so a database dump alone yields no usable key material. The Key
# Encryption Key (KEK) lives in a mounted FILE, never in this .env and never
# in the database -- putting it here would defeat the point, since a leaked
# .env plus a leaked dump would be the same as plaintext keys.
#
#   1. ./scripts/generate_dkim_kek.sh          # writes ./secrets/encryption_kek
#   2. mount it read-only into the api service at /run/secrets/encryption_kek
#   3. back it up somewhere separate from your database backups
#
# Existing installs also have plaintext keys already sitting in the database
# from before this shipped. Those must be assumed compromised -- run
# `python3 scripts/generate_dkim.py --rotate-all`, which mints fresh keys,
# clears the old plaintext, and prints the new DNS TXT record for every
# domain. Publish those records.
#
# Only set this if you mount the KEK somewhere other than the default path.
# ENCRYPTION_KEK_PATH=/run/secrets/encryption_kek

# -----------------------------------------------------------------------------
# API / ADMIN CREDENTIALS
# -----------------------------------------------------------------------------
# Startup fails closed on any secret in this file that is missing, still a
# CHANGE_ME_ placeholder, or shorter than 16 characters
# (worker/api/startup_checks.py). Check the whole set before bringing the
# stack up:  python3 worker/api/startup_checks.py
ADMIN_TOKEN_SECRET=CHANGE_ME_random_32char_secret
ADMIN_PASSWORD=CHANGE_ME_admin_password

# Flask / FastAPI runtime
FLASK_ENV=development
FLASK_DEBUG=0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MTA-STS mode: none | testing | enforce
MTA_STS_MODE=testing

# -----------------------------------------------------------------------------
# WEBMAIL CLIENT (optional)
# -----------------------------------------------------------------------------
# Enable a webmail client by setting COMPOSE_PROFILES:
#   COMPOSE_PROFILES=roundcube        # Roundcube (lightweight webmail)
#   COMPOSE_PROFILES=sogo             # SOGo (webmail + calendar + contacts)
#   COMPOSE_PROFILES=roundcube,sogo   # Both
#   (leave empty or omit for no webmail — API-only mode)
COMPOSE_PROFILES=roundcube

# Roundcube settings
ROUNDCUBE_PORT=8880
ROUNDCUBE_DB_NAME=roundcubemail

# SOGo settings
SOGO_PORT=8881
SOGO_DB_NAME=sogo
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# Service-specific logging
POSTFIX_LOG_LEVEL=info
DOVECOT_LOG_LEVEL=info
MYSQL_LOG_LEVEL=error
WEBHOOK_LOG_LEVEL=info
TRACKING_LOG_LEVEL=info

LOG_TO_FILE=true
LOG_TO_STDOUT=true

# -----------------------------------------------------------------------------
# MAIL STORAGE
# -----------------------------------------------------------------------------
MAIL_STORAGE_PATH=/var/mail/vhosts

# -----------------------------------------------------------------------------
# DEVELOPMENT AND TESTING
# -----------------------------------------------------------------------------
DEVELOPMENT_MODE=true
DEBUG_MODE=true
TESTING_MODE=false

# Test email configuration
TEST_EMAIL_ENABLED=false
TEST_EMAIL_FROM=test@yourdomain.com
TEST_EMAIL_TO=admin@yourdomain.com
