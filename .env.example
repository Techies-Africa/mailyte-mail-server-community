# =============================================================================
# ENTERPRISE EMAIL SERVER ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# DOCKER COMPOSE PROJECT NAME
# -----------------------------------------------------------------------------
# Without this, Compose defaults the project name to the basename of whatever
# directory `docker compose` is run from. That's fine for a stable local
# checkout, but on a host that deploys into a fresh timestamped release
# directory each time (DevPilot and similar tools), every release would look
# like a brand-new, unrelated project -- silently orphaning the mysql_data/
# redis_data/rspamd_data/letsencrypt_data named volumes and colliding with
# the previous release's still-running fixed container names (mysql, redis,
# migrate, docker-proxy, etc.). Pinning it here makes every `docker compose`
# invocation across scripts/ and deployment/deploy.sh -- run from any
# directory -- resolve to the same project consistently. See
# deployment/deploy.sh's own header comment for the full explanation.
COMPOSE_PROJECT_NAME=mailyte-prod

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mailserver
DB_USER=root
DB_PASSWORD=password

# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# GENERAL EMAIL SERVER SETTINGS
# -----------------------------------------------------------------------------
HOSTNAME=mail.yourdomain.com
DOMAIN=yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/mail.crt
SSL_KEY_PATH=/etc/ssl/private/mail.key
ENABLE_TLS=true
TLS_PROTOCOLS=TLSv1.2,TLSv1.3

# -----------------------------------------------------------------------------
# POSTFIX CONFIGURATION
# -----------------------------------------------------------------------------
POSTFIX_MYHOSTNAME=mail.yourdomain.com
POSTFIX_MYDOMAIN=yourdomain.com
POSTFIX_MYORIGIN=$mydomain
POSTFIX_INET_INTERFACES=all
POSTFIX_INET_PROTOCOLS=ipv4

# Virtual mailbox settings
POSTFIX_VIRTUAL_MAILBOX_DOMAINS=mysql:/etc/postfix/mysql-virtual-mailbox-domains.cf
POSTFIX_VIRTUAL_MAILBOX_MAPS=mysql:/etc/postfix/mysql-virtual-mailbox-maps.cf
POSTFIX_VIRTUAL_ALIAS_MAPS=mysql:/etc/postfix/mysql-virtual-alias-maps.cf

# Message size limits
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
POSTFIX_MAILBOX_SIZE_LIMIT=1073741824

# Rate limiting
POSTFIX_ANVIL_RATE_TIME_UNIT=60s
POSTFIX_ANVIL_RATE_COUNT_MAX=20

# Security and filtering
POSTFIX_SMTPD_HELO_REQUIRED=yes
POSTFIX_SMTPD_DELAY_REJECT=yes
POSTFIX_DISABLE_VRFY_COMMAND=yes

# Content filtering
POSTFIX_CONTENT_FILTER=smtp-amavis:[127.0.0.1]:10024
POSTFIX_RECEIVE_OVERRIDE_OPTIONS=no_address_mappings

# Enhanced security settings
POSTFIX_SMTPD_SASL_SECURITY_OPTIONS=noanonymous,noplaintext
POSTFIX_SMTPD_SASL_TLS_SECURITY_OPTIONS=noanonymous
POSTFIX_SMTP_TLS_SECURITY_LEVEL=may
POSTFIX_SMTPD_TLS_SECURITY_LEVEL=may
POSTFIX_SMTP_TLS_NOTE_STARTTLS_OFFER=yes
POSTFIX_SMTPD_TLS_RECEIVED_HEADER=yes

# Header and body checks
POSTFIX_HEADER_CHECKS=regexp:/etc/postfix/header_checks
POSTFIX_BODY_CHECKS=regexp:/etc/postfix/body_checks
POSTFIX_MIME_HEADER_CHECKS=regexp:/etc/postfix/mime_header_checks

# -----------------------------------------------------------------------------
# DOVECOT CONFIGURATION
# -----------------------------------------------------------------------------
DOVECOT_MAIL_LOCATION=maildir:/var/mail/vhosts/%d/%n
DOVECOT_MAIL_PRIVILEGED_GROUP=mail
DOVECOT_FIRST_VALID_UID=1000
DOVECOT_LAST_VALID_UID=1000

# Authentication
DOVECOT_AUTH_MECHANISMS=plain login
DOVECOT_DISABLE_PLAINTEXT_AUTH=yes
DOVECOT_AUTH_SOCKET_PATH=/var/run/dovecot/auth-postfix

# SSL configuration
DOVECOT_SSL=required
DOVECOT_SSL_CERT_PATH=/etc/ssl/certs/mail.crt
DOVECOT_SSL_KEY_PATH=/etc/ssl/private/mail.key
DOVECOT_SSL_PROTOCOLS=!SSLv2 !SSLv3

# Logging and monitoring
DOVECOT_AUTH_VERBOSE=yes
DOVECOT_AUTH_DEBUG=no
DOVECOT_MAIL_DEBUG=no

# -----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION
# -----------------------------------------------------------------------------
# Main webhook URLs (comma-separated for multiple webhooks). This is the ONLY
# WEBHOOK_URLS in this file -- a duplicate key further down (previously
# resolving to the wrong port AND path, http://localhost:5000/webhooks/receive)
# was removed 2026-08-01 (03-mailyte-api/phase-07-tenant-surface.md task 7.0).
# For local development (Laravel running on the host via `php artisan serve`,
# this stack fully dockerized) point at the host through Docker Desktop's
# host.docker.internal, NOT localhost -- "localhost" inside a container means
# the container itself. Laravel's real receiver is
# POST /api/v1/webhooks/mailyte on port 4000 (conventions.md §2's port
# contract; 5000 is not a reserved port and was never Laravel's).
WEBHOOK_URLS=http://host.docker.internal:4000/api/v1/webhooks/mailyte

# Webhook security
WEBHOOK_SECRET=your-webhook-secret-key-here

# doveadm HTTP API key (SMTP API keys K1). Shared by dovecot (which serves
# the internal-only listener on 24180) and api (which flushes the auth cache
# through it when a credential is revoked/rotated/updated). Generate with:
# openssl rand -hex 24. Leaving it empty degrades to cache-TTL revocation
# (up to 1 hour) -- it never opens an unauthenticated admin surface.
DOVEADM_API_KEY=
WEBHOOK_ENCRYPTION_KEY=your-32-character-encryption-key

# Webhook behavior
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_BATCH_SIZE=50

# Webhook filtering by event type
WEBHOOK_ENABLED_EVENTS=email.smtp.inbound,email.smtp.outbound,email.imap.read,dovecot.auth.success

# Health monitoring webhooks
WEBHOOK_HEALTH_CHECK_ENABLED=true
WEBHOOK_HEALTH_CHECK_INTERVAL=300
WEBHOOK_HEALTH_CHECK_TIMEOUT=10
# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here
DEFAULT_WEBHOOK_URL=https://webhook.site/test
STORAGE_ALERT_WEBHOOK_URL=
STORAGE_REPORT_WEBHOOK_URL=
QUOTA_EXCEEDED_WEBHOOK_URL=

# Storage Usage Service Configuration
# Mail/attachment paths are NOT configured here -- worker/storage_usage/
# config.py reads MAIL_DATA_PATH/ATTACHMENT_PATH, which are set directly
# in docker-compose.yml's storage_usage service (container-internal paths,
# same convention as postfix/dovecot), not from this file.
STORAGE_USAGE_SERVICE_URL=http://localhost:8084
STORAGE_CALCULATION_INTERVAL=3600
STORAGE_BATCH_SIZE=1000

# Webhook Delivery and Cleanup Configuration
WEBHOOK_AUTO_CLEANUP_ENABLED=true
WEBHOOK_CLEANUP_INTERVAL_HOURS=6
WEBHOOK_DELETE_SUCCESSFUL_AFTER_HOURS=24
WEBHOOK_DELETE_FAILED_AFTER_HOURS=168
WEBHOOK_AUTO_DELETE_SUCCESSFUL=true
WEBHOOK_KEEP_FAILED_ONLY=true
WEBHOOK_MAX_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY=5
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=2.0
WEBHOOK_RETRY_MAX_DELAY=3600

# Webhook Cleanup Scheduler Configuration
WEBHOOK_CLEANUP_ENABLED=true
WEBHOOK_CLEANUP_SCHEDULE_HOURS=4
WEBHOOK_SUCCESSFUL_RETENTION_HOURS=24
WEBHOOK_FAILED_RETENTION_HOURS=72
WEBHOOK_CLEANUP_BATCH_SIZE=1000

# Webhook Retry Configuration
WEBHOOK_DEFAULT_MAX_RETRIES=3
WEBHOOK_DEFAULT_RETRY_DELAY=5
WEBHOOK_DEFAULT_BACKOFF_MULTIPLIER=2.0
WEBHOOK_DEFAULT_MAX_RETRY_DELAY=3600
WEBHOOK_RETRY_ON_HTTP_CODES=500,502,503,504,429

# -----------------------------------------------------------------------------
# EMAIL TRACKING CONFIGURATION
# -----------------------------------------------------------------------------
# Core tracking settings
TRACKING_ENABLED=true
OPEN_TRACKING_ENABLED=true
CLICK_TRACKING_ENABLED=true

# Tracking domain configuration
TRACKING_DOMAIN=yourdomain.com
TRACKING_SUBDOMAIN=track
TRACKING_PROTOCOL=https
TRACKING_REQUIRE_SSL=true

# Pixel tracking settings
TRACKING_PIXEL_CACHE_CONTROL=no-cache, no-store, must-revalidate
TRACKING_PIXEL_EXPIRES=0
TRACKING_PIXEL_SIZE=1x1

# Click tracking
CLICK_REDIRECT_TIMEOUT=30
CLICK_PRESERVE_QUERY_PARAMS=true
CLICK_PRESERVE_FRAGMENTS=true

# Database settings for tracking
TRACKING_BATCH_INSERT_SIZE=100
TRACKING_DB_POOL_SIZE=10
TRACKING_DB_TIMEOUT=30

# Webhook settings for tracking events
TRACKING_WEBHOOK_ENABLED=true
TRACKING_WEBHOOK_TIMEOUT=10
TRACKING_WEBHOOK_RETRY_ATTEMPTS=3
TRACKING_WEBHOOK_RETRY_DELAY=5

# Analytics and privacy
TRACK_USER_AGENT=true
TRACK_IP_ADDRESS=true
TRACK_GEOLOCATION=true
TRACK_DEVICE_INFO=true
TRACK_REFERRER=true

# Privacy settings
TRACKING_ANONYMIZE_IP=false
TRACKING_IP_RETENTION_DAYS=90
TRACKING_DATA_RETENTION_DAYS=365

# Performance settings
TRACKING_ASYNC_LOGGING=true
TRACKING_CACHE_CONFIGS=true
TRACKING_CACHE_TTL=300

# Link filtering
TRACKING_EXCLUDE_DOMAINS=localhost,127.0.0.1,yourdomain.com
TRACKING_EXCLUDE_PATTERNS=mailto:,tel:,ftp:,file:
TRACKING_PRESERVE_UTM_PARAMS=true

# Rate limiting
TRACKING_RATE_LIMIT_PER_IP=1000
TRACKING_RATE_LIMIT_WINDOW=3600

# -----------------------------------------------------------------------------
# RAG (RETRIEVAL-AUGMENTED GENERATION) CONFIGURATION
# -----------------------------------------------------------------------------

# Core RAG settings
RAG_MODE=local
RAG_TENANT_ID=default
RAG_HOST=0.0.0.0
RAG_PORT=8090
RAG_DEBUG=false
RAG_WORKERS=1

# Multi-tenancy
RAG_ENABLE_MULTI_TENANCY=true
RAG_TENANT_ISOLATION_LEVEL=collection

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_HTTPS=false
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=mailrag
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE_METRIC=cosine
QDRANT_TIMEOUT=30
QDRANT_POOL_SIZE=10
QDRANT_MAX_RETRIES=3

# Embedding Configuration
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_PRIVACY_MODE=true
EMBEDDING_DATA_STAYS_LOCAL=true
EMBEDDING_ENABLE_FALLBACK=true
EMBEDDING_MAX_REQUESTS_PER_MINUTE=1000
EMBEDDING_RETRY_ATTEMPTS=3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_ASYNC_PROCESSING=true
EMBEDDING_WORKER_POOL_SIZE=4

# OpenAI Configuration (if using OpenAI embeddings)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Azure OpenAI Configuration (if using Azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=

# HuggingFace Configuration
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=
HF_DEVICE=cpu

# Local Model Configuration
LOCAL_MODEL_PATH=
LOCAL_MODEL_CACHE_DIR=/storage/models

# Ollama Configuration (for local LLM server)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=nomic-embed-text

# Cohere Configuration
COHERE_API_KEY=
COHERE_MODEL=embed-english-v3.0

# Text Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_STRATEGY=recursive
CHUNK_ADAPTIVE=true
CHUNK_PRESERVE_SENTENCES=true
CHUNK_SEMANTIC=false

# Indexing Configuration
INDEXING_BATCH_SIZE=50
INDEXING_MAX_WORKERS=4
INDEXING_PARALLEL=true
INDEXING_DEDUPLICATION=true
INDEXING_MAX_RETRIES=3
INDEXING_SKIP_ON_ERROR=true

# Email Field Indexing (default settings)
INDEX_EMAIL_HEADERS=true
INDEX_EMAIL_BODY=true
INDEX_ATTACHMENTS=true
ANONYMIZE_PERSONAL_DATA=true

# Search Configuration
SEARCH_STRATEGY=semantic
SEARCH_TOP_K=10
SEARCH_SCORE_THRESHOLD=0.7
SEARCH_ENABLE_RERANKING=true
SEARCH_ENABLE_CACHING=true
SEARCH_CACHE_TTL=300

# Caching Configuration
RAG_ENABLE_CACHING=true
RAG_CACHE_TTL=3600
RAG_CACHE_BACKEND=memory

# Logging and Monitoring
RAG_LOG_LEVEL=INFO
RAG_ENABLE_METRICS=true
RAG_PERFORMANCE_TRACKING=true

# AI Transaction Logging
AI_TRANSACTION_DB_LOGGING=true
AI_TRANSACTION_WEBHOOK_ALWAYS=true
AI_TRANSACTION_WEBHOOK_EVENTS=rag.ai.transaction.started,rag.ai.transaction.completed,rag.ai.transaction.failed
AI_TRANSACTION_LOG_LEVEL=INFO
AI_TRANSACTION_BATCH_SIZE=50
AI_TRANSACTION_WEBHOOK_TIMEOUT=30
AI_TRANSACTION_WEBHOOK_RETRIES=3

# Error Handling and Resilience
RAG_CIRCUIT_BREAKER=true
RAG_GRACEFUL_DEGRADATION=true

# Performance Settings
RAG_ASYNC_PROCESSING=true
RAG_MAX_CONCURRENT_REQUESTS=100
RAG_REQUEST_QUEUING=true
RAG_MAX_QUEUE_SIZE=1000

# Data Retention
RAG_AUTO_CLEANUP_ENABLED=true
RAG_RETENTION_DAYS=365
RAG_ENABLE_ARCHIVE_MODE=false

# Security
RAG_ALLOWED_HOSTS=*
RAG_CORS_ORIGINS=*
RAG_ENABLE_DOCS=true

# Organization-specific configurations (JSON format)
# RAG_ORGANIZATION_CONFIGS={"organization_1":{"enabled_fields":["email_headers","email_body"],"chunk_size":500}}

# Primary organization ID for single-tenant mode
RAG_ORGANIZATION_ID=default

# -----------------------------------------------------------------------------
# HEALTH MONITORING CONFIGURATION
# -----------------------------------------------------------------------------
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=30

# System monitoring
MONITOR_CPU_THRESHOLD=80
MONITOR_MEMORY_THRESHOLD=85
MONITOR_DISK_THRESHOLD=90
MONITOR_LOAD_THRESHOLD=4.0

# Service monitoring
MONITOR_POSTFIX=true
MONITOR_DOVECOT=true
MONITOR_MYSQL=true
MONITOR_QDRANT=true

# Alert thresholds
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_LATENCY_THRESHOLD_MS=1000
ALERT_QUEUE_SIZE_THRESHOLD=1000

# DNSBL (blocklist) monitoring. Comma-separated IPv4s the monitoring service
# checks hourly against the major blocklists -- set to your sending IPs, e.g.
# the primary server IP plus the dedicated marketing IP once purchased. Empty
# disables the check.
DNSBL_CHECK_IPS=

# -----------------------------------------------------------------------------
# BACKUP AND ARCHIVAL CONFIGURATION
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=gzip

# Cloud sync (optional)
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_PROVIDER=s3
CLOUD_SYNC_BUCKET=your-backup-bucket
CLOUD_SYNC_ACCESS_KEY=
CLOUD_SYNC_SECRET_KEY=

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# Local Redis in development, AWS ElastiCache in production
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# AWS S3 CONFIGURATION
# Used from day one for email file storage, attachments, and backups
# Bucket folder prefix: mailyte/
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=development-local-1
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_S3_PREFIX=mailyte

# -----------------------------------------------------------------------------
# RATE LIMITING CONFIGURATION
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Enforce prepaid Send credits and the monthly app-sending pool at the policy
# consultation. Deliberately OFF by default: turn it on only after watching
# real traffic, since a mistake here defers mail rather than just mis-billing.
SEND_CREDIT_ENFORCEMENT=false

# -----------------------------------------------------------------------------
# MARKETING SENDING STREAM (SMTP-Send phase-01)
# -----------------------------------------------------------------------------
# Second source IP for marketing-classed organizations, so a campaign's
# complaint spike can never blacklist the IP carrying mailbox/transactional
# mail. Leave unset until the IP exists on the host (with its PTR set) --
# unset means the marketing transport is defined but unreachable and routing
# is identical to before. See plans/07-smtp-send/runbook-ip-flagged.md.
MARKETING_BIND_IP=
# EHLO name the marketing transport announces; must match the IP's PTR.
MARKETING_HELO_NAME=
# ON A DOCKER BRIDGE NETWORK (the normal deployment) MARKETING_BIND_IP alone
# does NOT change the egress IP: the public address is not in the container's
# namespace, so the bind is a no-op and Docker's MASQUERADE sends everything
# from the host's primary IP (proven by receiver headers, 2026-09-06). Set a
# free address inside the mailserver bridge subnet here; the entrypoint adds
# it to the container (needs NET_ADMIN, granted in compose) and the marketing
# transport binds it, while a host nat rule maps exactly that source to
# MARKETING_BIND_IP -- install deployment/marketing-egress/ on the host.
# Leave unset on host-network deployments (the public IP is bound directly).
MARKETING_CONTAINER_BIND_IP=
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# Bounce-rate tripwire: auto-pause an organization's outbound sending when its
# recent bounce rate breaches the threshold (a DEFER, not a bounce -- fully
# reversible, and the pause expires on its own). Same philosophy as
# SEND_CREDIT_ENFORCEMENT above: OFF by default so deploying changes nothing,
# but recommended ON once real traffic has been observed -- one bad list can
# burn the shared IPs for every customer faster than a human reacts.
TRIPWIRE_ENABLED=false
# Sliding window the bounce rate is measured over, in minutes.
TRIPWIRE_WINDOW_MINUTES=60
# Fewer messages than this in the window and no judgement is made -- below the
# floor a single unlucky bounce dominates the ratio.
TRIPWIRE_MIN_MESSAGES=50
# Pause when bounced/total in the window reaches this (0.05 = 5%).
TRIPWIRE_BOUNCE_RATE=0.05
# Spam-complaint rate threshold. Configured now, but dormant until phase-05
# feedback loops give complaints a production producer.
TRIPWIRE_COMPLAINT_RATE=0.003
# How long a pause holds before expiring on its own (21600 = 6h). Lift one
# early with DELETE /tripwire/{organization_id} on the rate limiter.
TRIPWIRE_PAUSE_TTL_SECONDS=21600

# Auto-suspend an SMTP credential whose own sending is mostly bouncing or
# rejected (per-key tripwire in the log ingestor). Recommended ON.
AUTO_SUSPEND_ENABLED=true

# Per-service rate limits
RATE_LIMIT_SMTP_PER_HOUR=100
RATE_LIMIT_IMAP_PER_HOUR=1000
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=100

# Organization-specific tracking configurations (JSON format)
# TRACKING_ORGANIZATION_CONFIGS={"organization_1":{"tracking_domain":"custom.domain.com","click_tracking_enabled":true}}

# -----------------------------------------------------------------------------
# SPAM AND SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# Rspamd configuration
RSPAMD_ENABLED=true
RSPAMD_HOST=rspamd
RSPAMD_PORT=11333

# Spam thresholds
SPAM_THRESHOLD_REJECT=15.0
SPAM_THRESHOLD_ADD_HEADER=6.0
SPAM_THRESHOLD_GREYLIST=4.0

# Security features
ENABLE_GREYLISTING=true
ENABLE_DKIM_SIGNING=true
ENABLE_SPF_CHECK=true
ENABLE_DMARC_CHECK=true

# Virus scanning
ENABLE_ANTIVIRUS=true
ANTIVIRUS_ENGINE=clamav

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# Service-specific logging
POSTFIX_LOG_LEVEL=info
DOVECOT_LOG_LEVEL=info
MYSQL_LOG_LEVEL=error
WEBHOOK_LOG_LEVEL=info
TRACKING_LOG_LEVEL=info
RAG_LOG_LEVEL=info

# Log destinations
LOG_TO_FILE=true
LOG_TO_STDOUT=true
LOG_TO_SYSLOG=false

# Performance logging
ENABLE_PERFORMANCE_LOGGING=true
PERFORMANCE_LOG_SLOW_QUERIES=true
PERFORMANCE_LOG_SLOW_THRESHOLD_MS=1000

# -----------------------------------------------------------------------------
# TEMPLATE MANAGEMENT SERVICE
# -----------------------------------------------------------------------------
TEMPLATE_SERVICE_PORT=8087
TEMPLATE_SERVICE_DEBUG=false
TEMPLATE_SERVICE_URL=http://localhost:8087

# Template configuration
TEMPLATE_CACHE_TTL=3600
TEMPLATE_VERSION_RETENTION=10
TEMPLATE_AB_TESTING_ENABLED=true

# -----------------------------------------------------------------------------
# DELIVERY OPTIMIZATION SERVICE
# -----------------------------------------------------------------------------
DELIVERY_OPTIMIZER_PORT=8088
DELIVERY_OPTIMIZER_DEBUG=false
DELIVERY_OPTIMIZER_URL=http://localhost:8088
DELIVERY_OPTIMIZER_SERVICE_NAME=delivery_optimizer

# ISP-specific limits (JSON format)
DELIVERY_ISP_LIMITS={"gmail.com":{"hourly_limit":100,"burst_limit":10},"outlook.com":{"hourly_limit":300,"burst_limit":20}}

# Delivery timing
DELIVERY_OPTIMIZATION_ENABLED=true
DELIVERY_RESPECT_ISP_LIMITS=true
DELIVERY_AUTO_THROTTLE=true

# -----------------------------------------------------------------------------
# EMAIL SUPPRESSION CONFIGURATION
# -----------------------------------------------------------------------------
SUPPRESSION_AUTO_BOUNCE=true
SUPPRESSION_AUTO_COMPLAINT=true
SUPPRESSION_BOUNCE_THRESHOLD_HARD=1
SUPPRESSION_BOUNCE_THRESHOLD_SOFT=5
SUPPRESSION_RETENTION_DAYS=90

# Feedback loop configuration
FBL_ENABLED=true
FBL_PROCESSORS=gmail,outlook,yahoo
FBL_AUTO_SUPPRESS=true

# -----------------------------------------------------------------------------
# DOMAIN REPUTATION TRACKING
# -----------------------------------------------------------------------------
REPUTATION_TRACKING_ENABLED=true
REPUTATION_UPDATE_INTERVAL=3600
REPUTATION_ALERT_THRESHOLD=30
REPUTATION_ISP_TRACKING=gmail,outlook,yahoo,aol

# -----------------------------------------------------------------------------
# SSL CERTIFICATE MANAGER CONFIGURATION
# -----------------------------------------------------------------------------
# ACME/Let's Encrypt settings
ACME_EMAIL=admin@yourdomain.com
ACME_STAGING=false
CERT_RENEWAL_DAYS=30
CERT_CHECK_INTERVAL=21600

# Certificate paths
SSL_CERT_PATH=/etc/ssl/certs
SSL_KEY_PATH=/etc/ssl/private

# Certificate manager webhooks
CERT_WEBHOOK_URL=
CERT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# DEVELOPMENT AND TESTING
# -----------------------------------------------------------------------------
DEVELOPMENT_MODE=true
DEBUG_MODE=true
TESTING_MODE=false

# Local development settings
LOCAL_DEV_HOST=0.0.0.0
LOCAL_DEV_API_PORT=5000
LOCAL_DEV_WEBHOOK_PORT=8081
LOCAL_DEV_TRACKING_PORT=8083

# Simplified logging for development
LOG_LEVEL=DEBUG
