LOG_TO_FILE=false

# Mock external services for development
MOCK_WEBHOOK_ENABLED=true
MOCK_CLOUD_SYNC=true
MOCK_EMAIL_DELIVERY=true

# Development database (use SQLite for local dev)
DEV_DB_TYPE=sqlite
DEV_DB_PATH=./dev_database.db

# Test email configuration
TEST_EMAIL_ENABLED=false
TEST_EMAIL_FROM=test@yourdomain.com
TEST_EMAIL_TO=admin@yourdomain.com

# Mock services for testing
MOCK_WEBHOOK_ENABLED=false
MOCK_QDRANT_ENABLED=false
MOCK_EMBEDDING_ENABLED=false

# -----------------------------------------------------------------------------
# RATE LIMITER SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
# Rate Limiter Service Configuration
RATE_LIMITER_SERVICE_NAME=rate_limiter
RATE_LIMITER_HOST=0.0.0.0
RATE_LIMITER_PORT=8082
RATE_LIMITER_DEBUG=false
RATE_LIMITER_LOG_LEVEL=INFO

# Rate Limiter Cache Settings
RATE_LIMIT_CACHE_TTL=300
ORG_MAPPING_CACHE_TTL=600
WEBHOOK_URLS_CACHE_TTL=300
USAGE_STATS_CACHE_TTL=60

# Rate Limiter Alert Thresholds (percentages)
RATE_LIMIT_WARNING_THRESHOLD=80
RATE_LIMIT_CRITICAL_THRESHOLD=95
RATE_LIMIT_EXCEEDED_THRESHOLD=100

# Default Rate Limits - Organization Level
ORG_INBOUND_HOURLY_DEFAULT=5000
ORG_INBOUND_DAILY_DEFAULT=50000
ORG_INBOUND_MONTHLY_DEFAULT=500000
ORG_INBOUND_BURST_DEFAULT=1000
ORG_OUTBOUND_HOURLY_DEFAULT=10000
ORG_OUTBOUND_DAILY_DEFAULT=100000
ORG_OUTBOUND_MONTHLY_DEFAULT=1000000
ORG_OUTBOUND_BURST_DEFAULT=2000

# Default Rate Limits - Domain Level
DOMAIN_INBOUND_HOURLY_DEFAULT=1000
DOMAIN_INBOUND_DAILY_DEFAULT=10000
DOMAIN_INBOUND_MONTHLY_DEFAULT=100000
DOMAIN_INBOUND_BURST_DEFAULT=200
DOMAIN_OUTBOUND_HOURLY_DEFAULT=2000
DOMAIN_OUTBOUND_DAILY_DEFAULT=20000
DOMAIN_OUTBOUND_MONTHLY_DEFAULT=200000
DOMAIN_OUTBOUND_BURST_DEFAULT=500

# Default Rate Limits - Mailbox Level
MAILBOX_INBOUND_HOURLY_DEFAULT=100
MAILBOX_INBOUND_DAILY_DEFAULT=1000
MAILBOX_INBOUND_MONTHLY_DEFAULT=10000
MAILBOX_INBOUND_BURST_DEFAULT=50
MAILBOX_OUTBOUND_HOURLY_DEFAULT=200
MAILBOX_OUTBOUND_DAILY_DEFAULT=2000
MAILBOX_OUTBOUND_MONTHLY_DEFAULT=20000
MAILBOX_OUTBOUND_BURST_DEFAULT=100

# Log Analyzer Configuration
LOG_ANALYZER_ENABLED=true
GEOIP_DB_PATH="/usr/share/GeoIP/GeoLite2-Country.mmdb"

# Queue Manager Configuration
QUEUE_MANAGER_ENABLED=true
QUEUE_MANAGER_PORT=5001

# Greylisting Configuration (Rspamd)
GREYLISTING_ENABLED=true
GREYLIST_TIMEOUT=300
GREYLIST_EXPIRE=86400

# =============================================================================
# MISSING / ADDITIONAL VARIABLES (added to complete configuration)
# =============================================================================

# -----------------------------------------------------------------------------
# ADMIN CREDENTIALS
# -----------------------------------------------------------------------------
# Root MySQL password (used by the mysql service)
DB_ROOT_PASSWORD=changeme_root_db_password

# Admin API token for protected management endpoints (X-Admin-Token header)
ADMIN_TOKEN_SECRET=changeme_replace_with_random_32char_secret
# Legacy alias — keep in sync with ADMIN_TOKEN_SECRET
ADMIN_PASSWORD=changeme_admin_password

# -----------------------------------------------------------------------------
# FLASK / FASTAPI RUNTIME
# -----------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=0
# Comma-separated list of allowed CORS origins (set to your dashboard URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secure flag on the mailyte_session/mailyte_csrf cookies (phase-03). Keep
# true in production (TLS). Set to false only for a CE user testing over
# plain http://localhost during first setup -- Secure cookies are dropped
# by the browser over http and would lock them out.
MAILYTE_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# POSTFIX RUNTIME DEFAULTS
# -----------------------------------------------------------------------------
# Used by Postfix entrypoint to seed default org/domain if needed
DEFAULT_TENANT_ID=
DEFAULT_DOMAIN_ID=

# -----------------------------------------------------------------------------
# OAUTH 2.0 / XOAUTH2
# -----------------------------------------------------------------------------
OAUTH_ISSUER=https://mail.example.com
OAUTH_TOKEN_SECRET=changeme_replace_with_random_oauth_secret

# -----------------------------------------------------------------------------
# URL PROTECTION (Safe Links)
# -----------------------------------------------------------------------------
SAFE_LINK_BASE_URL=https://mail.example.com/safe
URL_HMAC_SECRET=changeme_replace_with_random_hmac_secret

# -----------------------------------------------------------------------------
# TOTP / 2FA
# -----------------------------------------------------------------------------
TOTP_ISSUER=Mailyte

# -----------------------------------------------------------------------------
# GRAFANA
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# -----------------------------------------------------------------------------
# MTA-STS
# -----------------------------------------------------------------------------
# Mode: none | testing | enforce
MTA_STS_MODE=testing

# -----------------------------------------------------------------------------
# CLOUD STORAGE ALTERNATIVES (Azure / GCS)
# Leave blank to use AWS S3 (default)
# -----------------------------------------------------------------------------
CLOUD_PROVIDER=aws
# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=
# Google Cloud Storage
GCS_BUCKET=
GCS_CREDENTIALS_FILE=

# -----------------------------------------------------------------------------
# GEOIP DATABASE
# -----------------------------------------------------------------------------
# Path to MaxMind GeoLite2-Country.mmdb inside the geo-blocking container.
# You must provide a valid .mmdb file (download from https://dev.maxmind.com/)
# and mount it at this path in docker-compose.yml.
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-Country.mmdb

# -----------------------------------------------------------------------------
# WEBMAIL CLIENT (optional)
# -----------------------------------------------------------------------------
# Enable a webmail client by setting COMPOSE_PROFILES:
#   COMPOSE_PROFILES=roundcube        # Roundcube (lightweight webmail)
#   COMPOSE_PROFILES=sogo             # SOGo (webmail + calendar + contacts)
#   COMPOSE_PROFILES=roundcube,sogo   # Both
#   (leave empty or omit for no webmail — API-only mode)
COMPOSE_PROFILES=roundcube

# Roundcube settings
ROUNDCUBE_PORT=8880
ROUNDCUBE_DB_NAME=roundcubemail

# SOGo settings
SOGO_PORT=8881
SOGO_DB_NAME=sogo
TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Mailyte Console (PRD §9 shipping model)
#
# The console starts with the stack — it is not a separate deployment. These
# only need setting to override the defaults.
# ---------------------------------------------------------------------------

# Image tag. Pin this on a real deployment: `latest` means your console can
# change under you on the next `docker compose pull`.
CONSOLE_VERSION=latest

# Which edition this deployment reports at GET /api/v1/capabilities, which is
# what the console gates its navigation on. This repo is the enterprise
# edition, so `enterprise`. Leave it unset and the code falls back to
# "community" and the console hides DLP, reputation, compliance and the
# enterprise analytics screens without saying why.
MAILYTE_EDITION=enterprise

# Host port. 3100 matches the container port, the console's EXPOSE and its
# healthcheck (conventions §2 port contract). NOT 8085 — `monitoring` already
# publishes that one.
#
# Production ignores this: docker-compose.prod.yml strips published ports and
# routes through traefik at console.${DOMAIN} instead.
CONSOLE_PORT=3100

# PRODUCTION ONLY — who may reach the console, comma-separated CIDR.
#
# ADR-002 §7: VPN or IP allowlist, never public DNS. This console reads every
# tenant's metadata, revokes every session and can delete organizations, so it
# is the highest-value target in the stack. Left unset it defaults to
# 127.0.0.1/32 and nobody gets in — the correct direction to fail.
#
#   CONSOLE_ALLOWED_IPS=

CONSOLE_ALLOWED_IPS=

# PRODUCTION ONLY — which admin subdomains cert_manager issues certificates
# for. `console` MUST be in this list or https://console.<DOMAIN> has no
# certificate and traefik serves its self-signed default, which browsers
# refuse. Traefik's own ACME is deliberately unused here (see
# deployment/traefik/traefik.yml), so nothing else will issue it.
#
# Default if unset: api,autoconfig,jmap,caldav,docs,grafana,traefik
TRAEFIK_ADMIN_SUBDOMAINS=api,autoconfig,jmap,caldav,docs,grafana,traefik,console

# Cookie security for operator sessions is MAILYTE_COOKIE_SECURE, set further
# up this file — not COOKIE_SECURE, which nothing reads.

# -----------------------------------------------------------------------------
# Mailbox AI features (webmail + mobile: compose help, summaries, Maya)
# -----------------------------------------------------------------------------
# BYO OpenAI-compatible endpoint. Both AI_BASE_URL and AI_API_KEY must be set
# for /api/v1/mailbox/capabilities to report ai=true; with either unset every
# AI endpoint answers 503 ai_not_configured and clients hide the feature.
# These are the *mailbox* AI settings, read by the api service — distinct
# from OPENAI_*/AZURE_OPENAI_* above, which the RAG worker uses.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Native/mobile client version negotiation (X-Client-* request headers)
# -----------------------------------------------------------------------------
# Per platform: ios, android, web, macos, windows, linux. An unset platform is
# unrestricted; an unparseable client version never forces an update;
# FORCE_UPDATE_<PLATFORM>=1 forces X-Update-Required: true regardless of
# version (block a bad build without shipping a new minimum). The API only
# advises via response headers — the client enforces.
MIN_CLIENT_VERSION_IOS=
MIN_CLIENT_VERSION_ANDROID=
MIN_CLIENT_VERSION_WEB=
LATEST_CLIENT_VERSION_IOS=
LATEST_CLIENT_VERSION_ANDROID=
UPDATE_URL_IOS=
UPDATE_URL_ANDROID=
FORCE_UPDATE_IOS=0
FORCE_UPDATE_ANDROID=0
