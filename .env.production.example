# =============================================================================
# Mailyte Email Server — Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in ALL values before deploying.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ---- Core Domain Settings ----
DOMAIN=mailyte.com
HOSTNAME=mail.mailyte.com
ACME_EMAIL=admin@mailyte.com

# ---- Database (MySQL) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mailyte_mail
DB_USER=mailyte
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_HERE
# Read replica (optional, leave empty to use primary for reads)
DB_READ_HOST=
DB_READ_PORT=3306

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- AWS S3 Storage ----
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=mailyte-production
AWS_S3_PREFIX=mailyte

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Security ----
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_TOKEN_SECRET=CHANGE_ME_JWT_SECRET_64CHARS
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET
API_KEY=CHANGE_ME_API_KEY

# ---- TOTP / 2FA ----
TOTP_ISSUER=Mailyte

# ---- Postfix SMTP ----
TRACKING_ENABLED=true
DEFAULT_TENANT_ID=default
DEFAULT_DOMAIN_ID=default
TRACKING_SERVICE_URL=http://tracking:8086

# ---- SSL/TLS ----
SSL_CERT_PATH=/etc/ssl/certs
SSL_KEY_PATH=/etc/ssl/private
CERT_RENEWAL_DAYS=30
CERT_CHECK_INTERVAL=21600
# Set to "true" for Let's Encrypt staging (testing)
ACME_STAGING=false

# ---- MTA-STS ----
MTA_STS_MODE=enforce

# ---- Webhooks ----
WEBHOOK_URLS=https://your-webhook-endpoint.com/mailyte
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
SECURITY_WEBHOOK_URL=https://your-webhook-endpoint.com/security

# ---- Grafana Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ---- Traefik Reverse Proxy ----
TRAEFIK_DASHBOARD_USER=admin
# Generate with: htpasswd -nb admin YOUR_PASSWORD
TRAEFIK_DASHBOARD_PASS=$$apr1$$CHANGE_ME

# ---- AlertManager ----
ALERTMANAGER_SMTP_FROM=alerts@mailyte.com
ALERTMANAGER_SMTP_TO=ops@mailyte.com
ALERTMANAGER_WEBHOOK_URL=https://your-alerting-webhook.com/alerts

# ---- GeoIP (MaxMind) ----
# Download GeoLite2-Country.mmdb from MaxMind and mount it
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-Country.mmdb
MAXMIND_LICENSE_KEY=CHANGE_ME_MAXMIND_KEY

# ---- Backup ----
BACKUP_DIR=/var/backups/mailyte
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_ENABLED=true
S3_BUCKET=mailyte-production
S3_PREFIX=mailyte/backups

# ---- Mail Storage ----
MAIL_STORAGE_PATH=/var/mail/vhosts

# ---- RAG / AI ----
QDRANT_URL=http://qdrant:6333
OPENAI_API_KEY=CHANGE_ME_OPENAI_KEY
# Or use Anthropic / Ollama:
# ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_KEY
# OLLAMA_URL=http://ollama:11434

# ---- Flask/FastAPI ----
FLASK_ENV=production
FLASK_DEBUG=0

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_RATE_LIMIT_PER_HOUR=1000
DEFAULT_RATE_LIMIT_PER_DAY=10000
